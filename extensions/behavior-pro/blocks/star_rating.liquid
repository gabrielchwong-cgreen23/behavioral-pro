{% schema %}
{
  "name": "BehavioralPro",
  "target": "head",
  "settings": [
    {
      "type": "checkbox",
      "id": "expt_active",
      "label": "Run 14-Day Revenue Lift Test",
      "default": true
    },
    {
      "type": "text",
      "id": "backend_base",
      "label": "Backend Base URL",
      "default": "https://behavioral-pro-production.up.railway.app"
    },
    {
      "type": "checkbox",
      "id": "debug_mode",
      "label": "Enable Debug Logs",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "review_mode",
      "label": "Reviewer Demo Mode",
      "default": false
    },
    {
      "type": "range",
      "id": "review_delay_seconds",
      "label": "Reviewer Demo Delay (seconds)",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 3
    }
  ]
}
{% endschema %}

<script>
(function () {
  if (window.__behavioralProAgencyRevenueLiftLoaded) return;
  window.__behavioralProAgencyRevenueLiftLoaded = true;
  window.__BEHAVIORAL_PRO_BACKEND_BASE__ = {{ block.settings.backend_base | json }};
  if (window.console && typeof window.console.log === "function") {
    window.console.log("BehavioralPro embed loaded");
  }

  var CONFIG = {
    active: {{ block.settings.expt_active | json }},
    backendBase: {{ block.settings.backend_base | json }},
    debug: {{ block.settings.debug_mode | json }},
    reviewModeSetting: {{ block.settings.review_mode | json }},
    reviewDelayMs: {{ block.settings.review_delay_seconds | times: 1000 | json }},
    shopDomain: {{ shop.domain | json }},
    pageType: {{ request.page_type | json }},
    templateName: {{ template.name | json }},
    currency: {{ shop.currency | json }},
    productId: {{ product.id | json }},
    productHandle: {{ product.handle | json }},
    cartValue: {{ cart.total_price | divided_by: 100.0 | json }},

    gtmId: "GTM-3H5SLT7T",
    ga4Id: "G-6TZYV1S6L9",
    tidioId: "63hgfq26munthk1pfvmvz25ryddkjgsf",
    experimentName: "agency_revenue_lift_14_day",
    legacyMirrorsEnabled: true,
    tidioEnabled: true,
    sessionFrameTelemetryEnabled: true,
    shadowMode: false,
    allowedInterventionTypes: [],
    cooldownSeconds: 300,

    sessionKey: "behavioral_pro_session_id",
    variantKey: "behavioral_pro_variant",
    fallbackVariantKey: "behavioral_pro_fallback_variant",
    visitorKey: "behavioral_pro_visitor_id",
    eventDedupKey: "behavioral_pro_event_dedup",
    purchasePrefix: "behavioral_pro_purchase_",
    uiPrefix: "behavioral_pro_ui_",
    pageViewKey: "behavioral_pro_page_view",
    productPageViewKey: "behavioral_pro_product_page_view",
    addToCartKey: "behavioral_pro_add_to_cart_click",
    checkoutKey: "behavioral_pro_begin_checkout_click"
  };

  var ALLOWED_EVENT_NAMES = {
    experiment_assignment: 1,
    page_view: 1,
    product_view: 1,
    add_to_cart: 1,
    cart_open: 1,
    cart_close: 1,
    begin_checkout: 1,
    checkout_back: 1,
    purchase: 1,
    coupon_field_focus: 1,
    discount_code_applied: 1,
    quantity_change: 1,
    variant_change: 1,
    policy_page_view: 1,
    scroll_depth_reached: 1,
    product_dwell_12s: 1,
    review_section_dwell_10s: 1,
    cta_idle_15s: 1,
    rage_click: 1,
    state_node_transition: 1,
    session_frame: 1,
    exit_intent: 1,
    tidio_widget_open: 1,
    intervention_triggered: 1,
    intervention_type: 1
  };

  if (!CONFIG.active) return;

  var assignmentPromise = null;
  var assignmentReady = false;
  var tidioRequested = false;
  var tidioOpenBindingRequested = false;
  var memorySessionId = null;
  var clickTrackingBound = false;
  var fallbackUiMounted = false;
  var interactionDisplayed = false;
  var backendFailed = false;
  var tidioFailed = false;
  var decisionRequestInFlight = false;
  var pendingDecisionCheck = null;
  var lastDecisionStrategy = null;
  var ctaIdleTimer = null;
  var ctaIdleTarget = null;
  var ctaInteracted = false;
  var rageClickBuffer = [];
  var reviewObserver = null;
  var reviewDwellTimer = null;
  var reviewDwellFired = false;
  var motionTrackerStarted = false;
  var frameTelemetryStarted = false;
  var frameTimer = null;
  var frameState = null;
  var frameSessionStartedAtMs = 0;
  var STRICT_SESSION_DEDUPE_MS = 12 * 60 * 60 * 1000;
  var SHORT_EVENT_DEBOUNCE_MS = 1500;
  var MEDIUM_EVENT_DEBOUNCE_MS = 5000;
  var SESSION_FRAME_INTERVAL_MS = 2000;
  var DECISION_REQUEST_TIMEOUT_MS = 1000;
  var SAVED_CART_STORAGE_KEY = "behavioral_pro_saved_cart";
  var FAILURE_COUNT_STORAGE_KEY = "behavioral_pro_failure_count";
  var CIRCUIT_BROKEN_STORAGE_KEY = "behavioral_pro_circuit_broken";
  var CIRCUIT_REPORTED_STORAGE_KEY = "behavioral_pro_circuit_reported";
  var CIRCUIT_BREAKER_THRESHOLD = 3;
  var SILENT_FALLBACK_REASON = "silent_fallback";
  var INTERVENTION_MESSAGE_MATRIX = {
    tidio_checkout_recovery_v1: "If you're running into any technical issues or have a quick question about shipping times, let me know right here—I'm happy to look into it for you!",
    tidio_trust_reassurance_v1: "you can ask any policy questions here, we'll get you exactly what you need",
    tidio_friction_assistance_v1: "If theres anything you're having trouble with, I can manually process your request here",
    tidio_cohort_v1: "Let me know if you have any questions about anything you're looking at",
    tidio_cart_recovery_v1: "If you need anything else, please let me know. Otherwise, I've saved your initial items so you won't lose them!"
  };
  var COHORT_MESSAGE_IDS = {
    tidio_fast_conversion_nudge_v1: 1,
    tidio_reassurance_assist_v1: 1,
    tidio_high_touch_consultation_v1: 1
  };

  function log() {
    if (!CONFIG.debug || !window.console || typeof window.console.log !== "function") return;
    try {
      var args = ["[BehavioralPro]"].concat([].slice.call(arguments));
      window.console.log.apply(window.console, args);
    } catch (e) {}
  }

  function warn() {
    if (!window.console || typeof window.console.warn !== "function") return;
    try {
      var args = ["[BehavioralPro]"].concat([].slice.call(arguments));
      window.console.warn.apply(window.console, args);
    } catch (e) {}
  }

  function info(message) {
    if (!window.console || typeof window.console.log !== "function") return;
    try {
      window.console.log(message);
    } catch (e) {}
  }

  function errorLog(message, error) {
    if (!window.console || typeof window.console.error !== "function") return;
    try {
      if (error) {
        window.console.error(message, error);
      } else {
        window.console.error(message);
      }
    } catch (e) {}
  }

  function safeGetLocalStorage(key) {
    try {
      return window.localStorage.getItem(key);
    } catch (e) {
      return null;
    }
  }

  function safeSetLocalStorage(key, value) {
    try {
      window.localStorage.setItem(key, value);
    } catch (e) {}
  }

  function safeRemoveLocalStorage(key) {
    try {
      window.localStorage.removeItem(key);
    } catch (e) {}
  }

  function getSessionStorage() {
    try {
      window.sessionStorage.setItem("__bp_test", "1");
      window.sessionStorage.removeItem("__bp_test");
      return window.sessionStorage;
    } catch (e) {
      return null;
    }
  }

  function safeGetSessionStorage(key) {
    try {
      return window.sessionStorage.getItem(key);
    } catch (e) {
      return null;
    }
  }

  function safeSetSessionStorage(key, value) {
    try {
      window.sessionStorage.setItem(key, value);
    } catch (e) {}
  }

  function safeRemoveSessionStorage(key) {
    try {
      window.sessionStorage.removeItem(key);
    } catch (e) {}
  }

  function parseFailureCount(value) {
    var parsed = parseInt(value == null ? "" : String(value), 10);
    if (!isFinite(parsed) || parsed <= 0) {
      return 0;
    }
    return Math.min(CIRCUIT_BREAKER_THRESHOLD, parsed);
  }

  function isCircuitBroken() {
    return safeGetSessionStorage(CIRCUIT_BROKEN_STORAGE_KEY) === "true";
  }

  function buildSilentFallbackDecision() {
    return {
      decision: false,
      strategy: SILENT_FALLBACK_REASON,
      intervention_type: "none",
      shadow_mode: false,
      metadata: {
        reason: SILENT_FALLBACK_REASON
      }
    };
  }

  function stringifyError(error) {
    try {
      if (error && typeof error === "object") {
        if (typeof error.stack === "string" && error.stack) return error.stack;
        if (typeof error.message === "string" && error.message) return error.message;
      }
      if (typeof error === "string") return error;
      return JSON.stringify(error);
    } catch (e) {
      try {
        return String(error);
      } catch (stringError) {
        return "unknown_error";
      }
    }
  }

  function reportCircuitBreakerTrip(error) {
    if (safeGetSessionStorage(CIRCUIT_REPORTED_STORAGE_KEY) === "true") {
      return;
    }

    safeSetSessionStorage(CIRCUIT_REPORTED_STORAGE_KEY, "true");
    postJsonBeacon("/api/log-system-error", {
      shop_domain: CONFIG.shopDomain,
      error_context: "circuit_breaker_tripped",
      error_message: stringifyError(error)
    });
  }

  function resetDecisionFailureCount() {
    safeSetSessionStorage(FAILURE_COUNT_STORAGE_KEY, "0");
  }

  function recordDecisionFailure(error) {
    if (isCircuitBroken()) {
      return;
    }

    var nextCount = Math.min(
      CIRCUIT_BREAKER_THRESHOLD,
      parseFailureCount(safeGetSessionStorage(FAILURE_COUNT_STORAGE_KEY)) + 1
    );
    safeSetSessionStorage(FAILURE_COUNT_STORAGE_KEY, String(nextCount));

    if (nextCount === CIRCUIT_BREAKER_THRESHOLD) {
      safeSetSessionStorage(CIRCUIT_BROKEN_STORAGE_KEY, "true");
      reportCircuitBreakerTrip(error);
    }
  }

  function nowIso() {
    return new Date().toISOString();
  }

  function getQueryParam(name) {
    try {
      return new URL(window.location.href).searchParams.get(name);
    } catch (e) {
      return null;
    }
  }

  function createId(prefix) {
    try {
      if (window.crypto && typeof window.crypto.randomUUID === "function") {
        return prefix + "_" + window.crypto.randomUUID();
      }
    } catch (e) {}

    return prefix + "_" + Math.random().toString(36).slice(2) + "_" + Date.now();
  }

  function getReviewModeFlag() {
    var flag = getQueryParam("behavioralpro_review");
    if (flag === "1" || flag === "true") {
      return true;
    }
    if (flag === "0" || flag === "false") {
      return false;
    }
    return false;
  }

  CONFIG.reviewMode = getReviewModeFlag();

  if (CONFIG.reviewMode) {
    info("BehavioralPro review mode active");
  }

  function getDeviceType() {
    var width = window.innerWidth || 0;
    if (width && width < 768) return "mobile";
    if (width && width < 1024) return "tablet";
    return "desktop";
  }

  function getTrafficSource() {
    var utmSource = getQueryParam("utm_source");
    if (utmSource) return utmSource;

    try {
      if (document.referrer) {
        return new URL(document.referrer).hostname || "referral";
      }
    } catch (e) {}

    return "direct";
  }

  function getBaseEventContext() {
    return {
      referrer: document.referrer || null,
      traffic_source: getTrafficSource(),
      device_type: getDeviceType(),
      product_id: CONFIG.productId || null,
      product_handle: CONFIG.productHandle || null,
      cart_value: typeof CONFIG.cartValue === "number" ? CONFIG.cartValue : null,
      template_name: CONFIG.templateName || null,
      currency: CONFIG.currency || null
    };
  }

  function createSessionId() {
    var randomPart = "";

    try {
      if (window.crypto && typeof window.crypto.randomUUID === "function") {
        randomPart = window.crypto.randomUUID().replace(/-/g, "");
      } else if (window.crypto && typeof window.crypto.getRandomValues === "function") {
        var array = new Uint32Array(4);
        window.crypto.getRandomValues(array);
        randomPart = Array.prototype.map.call(array, function (part) {
          return part.toString(36);
        }).join("");
      }
    } catch (e) {}

    if (!randomPart) {
      randomPart = Math.random().toString(36).slice(2) + Date.now().toString(36);
    }

    return "session_" + randomPart;
  }

  function getVisitorId() {
    var existing = safeGetLocalStorage(CONFIG.visitorKey);
    if (existing) return existing;

    var id = createId("v");
    safeSetLocalStorage(CONFIG.visitorKey, id);
    return id;
  }

  function getSessionId() {
    var sessionStorageRef = getSessionStorage();

    if (sessionStorageRef) {
      var existingSession = sessionStorageRef.getItem(CONFIG.sessionKey);
      if (existingSession) return existingSession;

      var newSessionId = createSessionId();
      try {
        sessionStorageRef.setItem(CONFIG.sessionKey, newSessionId);
      } catch (e) {}
      return newSessionId;
    }

    if (!memorySessionId) {
      memorySessionId = createSessionId();
    }

    return memorySessionId;
  }

  function getStoredVariant() {
    var sessionStorageRef = getSessionStorage();
    if (!sessionStorageRef) return null;

    var variant = sessionStorageRef.getItem(CONFIG.variantKey);
    return variant === "control" || variant === "variant" ? variant : null;
  }

  function setStoredVariant(variant) {
    if (variant !== "control" && variant !== "variant") return;

    var sessionStorageRef = getSessionStorage();
    if (!sessionStorageRef) return;

    try {
      sessionStorageRef.setItem(CONFIG.variantKey, variant);
    } catch (e) {}
  }

  function getFallbackVariant() {
    var sessionStorageRef = getSessionStorage();
    if (!sessionStorageRef) return null;

    var variant = sessionStorageRef.getItem(CONFIG.fallbackVariantKey);
    return variant === "control" || variant === "variant" ? variant : null;
  }

  function setFallbackVariant(variant) {
    if (variant !== "control" && variant !== "variant") return;

    var sessionStorageRef = getSessionStorage();
    if (!sessionStorageRef) return;

    try {
      sessionStorageRef.setItem(CONFIG.fallbackVariantKey, variant);
    } catch (e) {}
  }

  function getOrCreateFallbackVariant() {
    var existing = getFallbackVariant();
    if (existing) return existing;

    var variant = Math.random() < 0.5 ? "control" : "variant";
    setFallbackVariant(variant);
    return variant;
  }

  function getEventDedupMap() {
    var raw = safeGetSessionStorage(CONFIG.eventDedupKey);
    if (!raw) return {};

    try {
      var parsed = JSON.parse(raw);
      return parsed && typeof parsed === "object" ? parsed : {};
    } catch (e) {
      return {};
    }
  }

  function setEventDedupMap(map) {
    safeSetSessionStorage(CONFIG.eventDedupKey, JSON.stringify(map || {}));
  }

  function pruneEventDedupMap(map, now) {
    var next = map || {};
    var currentTime = typeof now === "number" ? now : Date.now();
    Object.keys(next).forEach(function (key) {
      var value = Number(next[key] || 0);
      if (!value || currentTime - value > STRICT_SESSION_DEDUPE_MS) {
        delete next[key];
      }
    });
    return next;
  }

  function getEventDedupTimestamp(signature) {
    var map = getEventDedupMap();
    return Number(map[signature] || 0);
  }

  function rememberEventSignature(signature) {
    var map = getEventDedupMap();
    var now = Date.now();
    map[signature] = now;
    pruneEventDedupMap(map, now);
    setEventDedupMap(map);
  }

  function shouldSuppressEventSignature(signature, windowMs) {
    var lastSeenAt = getEventDedupTimestamp(signature);
    if (!lastSeenAt) return false;

    var ttl = Number(windowMs || 0);
    if (ttl <= 0) return false;

    return (Date.now() - lastSeenAt) < ttl;
  }

  function shouldSuppressOncePerSession(signature) {
    return shouldSuppressEventSignature(signature, STRICT_SESSION_DEDUPE_MS);
  }

  function shouldSuppressRapidDuplicate(signature) {
    return shouldSuppressEventSignature(signature, SHORT_EVENT_DEBOUNCE_MS);
  }

  function normalizeBaseUrl(url) {
    return String(url || "").replace(/\/+$/, "");
  }

  function ensureTrailingSlash(value) {
    var normalized = String(value || "/");
    return /\/$/.test(normalized) ? normalized : (normalized + "/");
  }

  function getShopifyAjaxUrl(path) {
    var root =
      window.Shopify &&
      window.Shopify.routes &&
      typeof window.Shopify.routes.root === "string"
        ? window.Shopify.routes.root
        : "/";
    var normalizedRoot = ensureTrailingSlash(root.charAt(0) === "/" ? root : ("/" + root));
    return normalizedRoot + String(path || "").replace(/^\/+/, "");
  }

  function normalizeSavedCartItems(items) {
    if (!Array.isArray(items)) return [];

    return items.reduce(function (acc, rawItem) {
      if (!rawItem || typeof rawItem !== "object" || Array.isArray(rawItem)) {
        return acc;
      }

      var id = Number(rawItem.id);
      var quantity = Number(rawItem.quantity);
      if (!Number.isFinite(id) || !Number.isFinite(quantity) || quantity <= 0) {
        return acc;
      }

      acc.push({
        id: Math.trunc(id),
        quantity: Math.trunc(quantity)
      });
      return acc;
    }, []);
  }

  async function snapshotActiveCart() {
    if (typeof window.fetch !== "function") return false;

    try {
      var response = await window.fetch(getShopifyAjaxUrl("/cart.js"), {
        method: "GET",
        headers: {
          Accept: "application/json"
        },
        credentials: "same-origin"
      });

      if (!response.ok) {
        return false;
      }

      var json = await response.json().catch(function () {
        return null;
      });
      var items = normalizeSavedCartItems(json && json.items);
      if (!items.length) {
        safeRemoveLocalStorage(SAVED_CART_STORAGE_KEY);
        return false;
      }

      safeSetLocalStorage(SAVED_CART_STORAGE_KEY, JSON.stringify(items));
      return true;
    } catch (e) {
      warn("Failed to snapshot active cart", e);
      return false;
    }
  }

  function resolveInterventionMessageId(eventType, messageId) {
    var normalizedMessageId = String(messageId || "").trim();
    if (INTERVENTION_MESSAGE_MATRIX[normalizedMessageId]) {
      return normalizedMessageId;
    }

    if (COHORT_MESSAGE_IDS[normalizedMessageId]) {
      return "tidio_cohort_v1";
    }

    if (eventType === "checkout_recovery") {
      return "tidio_checkout_recovery_v1";
    }
    if (eventType === "trust_reassurance") {
      return "tidio_trust_reassurance_v1";
    }
    if (eventType === "friction_assistance") {
      return "tidio_friction_assistance_v1";
    }
    if (eventType === "cart_recovery") {
      return "tidio_cart_recovery_v1";
    }
    return "tidio_cohort_v1";
  }

  function isUsableBackendBase(base) {
    if (!base) return false;
    if (base.indexOf("localhost") !== -1) return false;
    if (base.indexOf("127.0.0.1") !== -1) return false;
    return true;
  }

  function postJson(path, body, options) {
    var base = normalizeBaseUrl(CONFIG.backendBase);
    var requestOptions = options || {};

    if (typeof window.fetch !== "function" || !isUsableBackendBase(base)) {
      return Promise.reject(new Error("backend_unavailable"));
    }

    return window.fetch(base + path, {
      method: "POST",
      headers: {
        "Content-Type": "application/json"
      },
      body: JSON.stringify(body),
      keepalive: true,
      credentials: "omit",
      mode: "cors",
      signal: requestOptions.signal
    }).then(function (response) {
      if (response.redirected) {
        throw new Error("redirected_request:" + response.status);
      }
      return response;
    });
  }

  function postJsonBeacon(path, body) {
    var base = normalizeBaseUrl(CONFIG.backendBase);

    if (!isUsableBackendBase(base)) {
      return false;
    }

    var payload = JSON.stringify(body);

    if (typeof navigator !== "undefined" && typeof navigator.sendBeacon === "function") {
      try {
        if (navigator.sendBeacon(base + path, new Blob([payload], { type: "application/json" }))) {
          return true;
        }
      } catch (e) {}
    }

    if (typeof window.fetch === "function") {
      window.fetch(base + path, {
        method: "POST",
        headers: {
          "Content-Type": "application/json"
        },
        body: payload,
        keepalive: true,
        credentials: "omit",
        mode: "cors"
      }).catch(function () {});
      return true;
    }

    return false;
  }

  function startPackedMotionTracking() {
    if (motionTrackerStarted || !assignmentReady) return;
    motionTrackerStarted = true;

    var MAX_SAMPLES = 64;
    var TARGET_DWELL_MS = 2000;
    var CHECK_MS = 100;
    var VELOCITY_THRESHOLD = 0.03;
    var samples = [];
    var lastX = 0;
    var lastY = 0;
    var lastTs = 0;
    var lastVelocity = 0;
    var lastScrollX = Math.max(0, window.scrollX || 0);
    var lastScrollY = Math.max(0, window.scrollY || 0);
    var targetCandidate = null;
    var scrollTicking = false;

    function readScrollOffsets() {
      lastScrollX = Math.max(0, window.scrollX || document.documentElement.scrollLeft || 0);
      lastScrollY = Math.max(0, window.scrollY || document.documentElement.scrollTop || 0);
    }

    function getElementLabel(el) {
      if (!el) return null;
      var label = String(
        el.getAttribute("aria-label") || "" ||
        el.getAttribute("data-action") || "" ||
        el.getAttribute("name") || "" ||
        el.textContent || "" ||
        el.value || "" ||
        el.id || "" ||
        el.className || ""
      ).replace(/\s+/g, " ").trim();
      return label || null;
    }

    function getSizingChartTarget(target) {
      if (!target || !target.closest) return null;
      var el = target.closest('button, a, summary, [role="button"], [data-size-chart], [data-sizing-chart]');
      if (!el) return null;

      var text = String(
        (el.textContent || "") + " " +
        (el.getAttribute("aria-label") || "") + " " +
        (el.getAttribute("data-size-chart") || "") + " " +
        (el.getAttribute("data-sizing-chart") || "") + " " +
        (el.getAttribute("href") || "") + " " +
        (el.id || "") + " " +
        (typeof el.className === "string" ? el.className : "")
      ).toLowerCase();

      if (
        text.indexOf("size chart") !== -1 ||
        text.indexOf("sizing chart") !== -1 ||
        text.indexOf("size guide") !== -1 ||
        text.indexOf("sizing guide") !== -1
      ) {
        return el;
      }

      return null;
    }

    function getHighValueHoverTarget(target) {
      var checkoutTarget = isBeginCheckoutTarget(target)
        ? target.closest('button, input[type="submit"], input[type="button"], a, form[action*="/checkout"]')
        : null;
      if (checkoutTarget) {
        return {
          kind: "checkout_button",
          element: checkoutTarget,
          label: getElementLabel(checkoutTarget)
        };
      }

      var sizingChartTarget = getSizingChartTarget(target);
      if (sizingChartTarget) {
        return {
          kind: "sizing_chart",
          element: sizingChartTarget,
          label: getElementLabel(sizingChartTarget)
        };
      }

      return null;
    }

    function pushSample(x, y, ts) {
      var velocity = 0;

      if (lastTs > 0 && ts > lastTs) {
        var dx = x - lastX;
        var dy = y - lastY;
        velocity = Math.sqrt(dx * dx + dy * dy) / (ts - lastTs);
      }

      lastVelocity = velocity;
      lastX = x;
      lastY = y;
      lastTs = ts;

      samples.push({
        x: x,
        y: y,
        t: ts,
        sx: lastScrollX,
        sy: lastScrollY,
        v: velocity
      });

      if (samples.length > MAX_SAMPLES) {
        samples.shift();
      }
    }

    function resetTargetCandidate() {
      targetCandidate = null;
    }

    function sendStateTransition(candidate, durationMs) {
      if (!candidate || !assignmentReady) return;

      var variant = getStoredVariant();
      if (variant !== "control" && variant !== "variant") return;

      var signature = "state_node_transition:" + candidate.kind + ":" + window.location.pathname + ":" + (candidate.label || "unknown");
      if (shouldSuppressOncePerSession(signature)) return;
      rememberEventSignature(signature);

      var visitorId = getVisitorId();
      var sessionId = getSessionId();
      var context = getBaseEventContext();
      var latest = samples.length ? samples[samples.length - 1] : null;
      var effectiveVelocity = (Date.now() - lastTs) > 80 ? 0 : lastVelocity;

      postJsonBeacon("/api/events", {
        anonymous_id: visitorId,
        session_id: sessionId,
        event_name: "state_node_transition",
        timestamp: Math.floor(Date.now() / 1000),
        experiment_variant: variant,
        properties: {
          referrer: context.referrer,
          traffic_source: context.traffic_source,
          device_type: context.device_type,
          product_id: context.product_id,
          product_handle: context.product_handle,
          cart_value: context.cart_value,
          template_name: context.template_name,
          currency: context.currency,
          shop_domain: CONFIG.shopDomain,
          path: window.location.pathname,
          experiment_variant: variant,
          client_event_id: createId("evt"),
          state_transition: {
            from: "pointer_tracking",
            to: "target_stationary",
            trigger: "velocity_below_threshold_duration_met",
            target_kind: candidate.kind,
            target_label: candidate.label,
            target_duration_ms: Math.round(durationMs),
            velocity_px_per_ms: Number(effectiveVelocity.toFixed(4)),
            scroll_x: latest ? latest.sx : lastScrollX,
            scroll_y: latest ? latest.sy : lastScrollY
          }
        }
      });
    }

    function evaluateTargetIntent() {
      if (!lastTs) return;
      var effectiveVelocity = (Date.now() - lastTs) > 80 ? 0 : lastVelocity;

      var targetElement = document.elementFromPoint(lastX, lastY);
      var highValueTarget = getHighValueHoverTarget(targetElement);

      if (!highValueTarget || effectiveVelocity > VELOCITY_THRESHOLD) {
        resetTargetCandidate();
        return;
      }

      var signature = highValueTarget.kind + ":" + (highValueTarget.label || "unknown");
      if (!targetCandidate || targetCandidate.signature !== signature) {
        targetCandidate = {
          signature: signature,
          kind: highValueTarget.kind,
          label: highValueTarget.label,
          startedAt: Date.now()
        };
        return;
      }

      if (!targetCandidate.sent && (Date.now() - targetCandidate.startedAt) >= TARGET_DWELL_MS) {
        targetCandidate.sent = true;
        sendStateTransition(targetCandidate, Date.now() - targetCandidate.startedAt);
        samples = [];
      }
    }

    document.addEventListener("mousemove", function (event) {
      readScrollOffsets();
      pushSample(event.clientX || 0, event.clientY || 0, Date.now());
      evaluateTargetIntent();
    }, { passive: true });

    window.addEventListener("scroll", function () {
      if (scrollTicking) return;
      scrollTicking = true;
      window.requestAnimationFrame(function () {
        scrollTicking = false;
        readScrollOffsets();
      });
    }, { passive: true });

    window.setInterval(evaluateTargetIntent, CHECK_MS);
    window.addEventListener("pagehide", resetTargetCandidate);
    document.addEventListener("visibilitychange", function () {
      if (document.visibilityState === "hidden") {
        resetTargetCandidate();
      }
    });
  }

  function getJson(path, params) {
    var base = normalizeBaseUrl(CONFIG.backendBase);

    if (typeof window.fetch !== "function" || !isUsableBackendBase(base)) {
      return Promise.reject(new Error("backend_unavailable"));
    }

    var url = new URL(base + path);
    Object.keys(params || {}).forEach(function (key) {
      var value = params[key];
      if (value == null || value === "") return;
      url.searchParams.set(key, String(value));
    });

    return window.fetch(url.toString(), {
      method: "GET",
      credentials: "omit",
      mode: "cors",
      cache: "no-store"
    }).then(function (response) {
      if (response.redirected) {
        throw new Error("redirected_request:" + response.status);
      }
      return response;
    });
  }

  function isCartPage() {
    return CONFIG.pageType === "cart" || window.location.pathname === "/cart";
  }

  function isCheckoutPage() {
    return window.location.pathname.indexOf("/checkouts/") === 0 || CONFIG.pageType === "checkout";
  }

  function shouldTrackSessionFrames() {
    if (!CONFIG.sessionFrameTelemetryEnabled || !assignmentReady) return false;
    if (isCheckoutPage()) return false;
    return isSupportedInteractionPage() || isCartPage();
  }

  function getDocumentScrollDepth() {
    var doc = document.documentElement;
    var body = document.body;
    var height = Math.max(
      body ? body.scrollHeight : 0,
      doc ? doc.scrollHeight : 0,
      body ? body.offsetHeight : 0,
      doc ? doc.offsetHeight : 0
    );
    var viewport = window.innerHeight || (doc ? doc.clientHeight : 0) || 0;
    var scrollTop = window.scrollY || (doc ? doc.scrollTop : 0) || 0;
    var maxScrollable = Math.max(height - viewport, 1);
    return Math.max(0, Math.min(1, (scrollTop + viewport) / maxScrollable));
  }

  function createZoneHoverMap() {
    return {
      add_to_cart_zone: 0,
      checkout_button_zone: 0,
      price_zone: 0,
      reviews_zone: 0,
      shipping_policy_zone: 0,
      return_policy_zone: 0
    };
  }

  function createFrameState(previous) {
    var carry = previous || {};
    return {
      startedAtMs: frameSessionStartedAtMs || Date.now(),
      lastPointerX: carry.lastPointerX != null ? carry.lastPointerX : null,
      lastPointerY: carry.lastPointerY != null ? carry.lastPointerY : null,
      lastPointerTs: carry.lastPointerTs || 0,
      lastVelocity: carry.lastVelocity || 0,
      lastScrollY: window.scrollY || 0,
      lastScrollTs: Date.now(),
      lastInteractionAt: carry.lastInteractionAt || Date.now(),
      currentZone: carry.currentZone || "unknown_zone",
      lastZoneAt: Date.now(),
      activeZone: carry.activeZone || "unknown_zone",
      zoneHoverMs: createZoneHoverMap(),
      mouseVelocitySum: 0,
      mouseVelocitySamples: 0,
      mouseVelocityMax: 0,
      mouseAccelerationSum: 0,
      mouseAccelerationSamples: 0,
      mouseDistance: 0,
      scrollVelocitySum: 0,
      scrollVelocitySamples: 0,
      latestScrollDepth: getDocumentScrollDepth(),
      clickCount: 0,
      rageClickCount: 0,
      deadClickCount: 0,
      recentClicks: []
    };
  }

  function getPageTypeLabel() {
    return String(CONFIG.pageType || "unknown").trim() || "unknown";
  }

  function getJourneyStageLabel(frame) {
    if (isCheckoutPage()) return "checkout";
    if (isCartPage()) return "cart";
    if (isProductPage()) {
      if ((frame.zoneHoverMs.add_to_cart_zone || 0) > 900 || frame.clickCount > 0) {
        return "decision";
      }
      if ((frame.zoneHoverMs.price_zone || 0) > 600 || (frame.zoneHoverMs.reviews_zone || 0) > 600) {
        return "consideration";
      }
      return "product";
    }
    if (isCollectionPage()) return "browse";
    if (isHomePage()) return "landing";
    return "unknown";
  }

  function getZoneDefinitions() {
    return [
      { name: "add_to_cart_zone", selectors: ['form[action*="/cart/add"]', 'button[name="add"]', 'button[id*="add-to-cart" i]', '[data-add-to-cart]', '[name="add"]'] },
      { name: "checkout_button_zone", selectors: ['form[action*="/checkout"]', 'a[href*="/checkout"]', 'button[name="checkout"]', '[data-checkout-button]'] },
      { name: "price_zone", selectors: ['[class*="price" i]', '[data-product-price]', '[data-price]'] },
      { name: "reviews_zone", selectors: ['#reviews', '[id*="review" i]', '[class*="review" i]', '[data-reviews]'] },
      { name: "variant_selector_zone", selectors: ['select[name*="option" i]', 'fieldset[name*="option" i]', '[data-variant-selector]', '[class*="variant" i]'] },
      { name: "size_chart_zone", selectors: ['[data-size-chart]', '[href*="size-chart" i]', '[href*="size-guide" i]'] },
      { name: "shipping_policy_zone", selectors: ['a[href*="shipping" i]', '[data-shipping-policy]', '[class*="shipping" i]'] },
      { name: "return_policy_zone", selectors: ['a[href*="return" i]', '[data-return-policy]', '[class*="return" i]'] },
      { name: "product_image_zone", selectors: ['[data-product-media]', '[class*="product__media" i]', '.product-media-container', 'img[src*="/products/"]'] },
      { name: "product_title_zone", selectors: ['h1', '[class*="product-title" i]', '[data-product-title]'] },
      { name: "chat_widget_zone", selectors: ['[id*="tidio" i]', '[class*="tidio" i]', '[data-tidio]'] }
    ];
  }

  function getZoneNameFromElement(target) {
    if (!target || !target.closest) return "unknown_zone";

    var definitions = getZoneDefinitions();
    for (var i = 0; i < definitions.length; i += 1) {
      var definition = definitions[i];
      for (var j = 0; j < definition.selectors.length; j += 1) {
        try {
          if (target.closest(definition.selectors[j])) {
            return definition.name;
          }
        } catch (e) {}
      }
    }

    if (getSizingChartTarget(target)) {
      return "size_chart_zone";
    }

    return "unknown_zone";
  }

  function updateZoneHover(now, nextZone) {
    if (!frameState) return;

    var elapsed = Math.max(0, now - (frameState.lastZoneAt || now));
    var currentZone = frameState.currentZone || "unknown_zone";
    if (frameState.zoneHoverMs[currentZone] != null) {
      frameState.zoneHoverMs[currentZone] += elapsed;
    }

    frameState.currentZone = nextZone || currentZone;
    frameState.activeZone = nextZone || currentZone;
    frameState.lastZoneAt = now;
  }

  function getPrimaryCtaCenter() {
    var cta = findPrimaryCta();
    if (!cta || !cta.getBoundingClientRect) return null;
    var rect = cta.getBoundingClientRect();
    return {
      x: rect.left + (rect.width / 2),
      y: rect.top + (rect.height / 2)
    };
  }

  function getCtaDistance() {
    if (!frameState || frameState.lastPointerX == null || frameState.lastPointerY == null) return 9999;
    var center = getPrimaryCtaCenter();
    if (!center) return 9999;
    var dx = frameState.lastPointerX - center.x;
    var dy = frameState.lastPointerY - center.y;
    return Math.sqrt(dx * dx + dy * dy);
  }

  function isDeadClickTarget(target) {
    if (!target || !target.closest) return true;
    if (target.closest('a, button, input, select, textarea, summary, label, [role="button"], [data-tidio]')) {
      return false;
    }
    return true;
  }

  function trackFrameClick(event) {
    if (!frameState) return;
    var now = Date.now();
    frameState.lastInteractionAt = now;
    frameState.clickCount += 1;
    if (isDeadClickTarget(event.target)) {
      frameState.deadClickCount += 1;
    }

    var point = {
      x: event.clientX || 0,
      y: event.clientY || 0,
      at: now
    };
    frameState.recentClicks = frameState.recentClicks.filter(function (item) {
      return now - item.at < 900;
    });
    frameState.recentClicks.push(point);

    if (frameState.recentClicks.length >= 3) {
      var recent = frameState.recentClicks.slice(-3);
      var maxDistance = 0;
      for (var i = 0; i < recent.length; i += 1) {
        for (var j = i + 1; j < recent.length; j += 1) {
          var dx = recent[i].x - recent[j].x;
          var dy = recent[i].y - recent[j].y;
          var distance = Math.sqrt(dx * dx + dy * dy);
          if (distance > maxDistance) maxDistance = distance;
        }
      }

      if (maxDistance < 30) {
        frameState.rageClickCount += 1;
        frameState.recentClicks = [];
      }
    }
  }

  function updateFramePointer(event) {
    if (!frameState) return;

    var now = Date.now();
    var x = event.clientX || 0;
    var y = event.clientY || 0;
    var velocity = 0;
    var acceleration = 0;
    if (frameState.lastPointerTs > 0 && now > frameState.lastPointerTs) {
      var dx = x - frameState.lastPointerX;
      var dy = y - frameState.lastPointerY;
      var dt = now - frameState.lastPointerTs;
      var distance = Math.sqrt(dx * dx + dy * dy);
      velocity = distance / dt;
      acceleration = (velocity - frameState.lastVelocity) / dt;
      frameState.mouseDistance += distance;
      frameState.mouseVelocitySum += velocity;
      frameState.mouseVelocitySamples += 1;
      frameState.mouseVelocityMax = Math.max(frameState.mouseVelocityMax, velocity);
      frameState.mouseAccelerationSum += acceleration;
      frameState.mouseAccelerationSamples += 1;
    }

    frameState.lastVelocity = velocity;
    frameState.lastPointerX = x;
    frameState.lastPointerY = y;
    frameState.lastPointerTs = now;
    frameState.lastInteractionAt = now;
    frameState.latestScrollDepth = getDocumentScrollDepth();
    updateZoneHover(now, getZoneNameFromElement(document.elementFromPoint(x, y)));
  }

  function updateFrameScroll() {
    if (!frameState) return;

    var now = Date.now();
    var nextY = window.scrollY || 0;
    var dt = Math.max(1, now - (frameState.lastScrollTs || now));
    var delta = nextY - (frameState.lastScrollY || 0);
    frameState.scrollVelocitySum += delta / dt;
    frameState.scrollVelocitySamples += 1;
    frameState.lastScrollY = nextY;
    frameState.lastScrollTs = now;
    frameState.lastInteractionAt = now;
    frameState.latestScrollDepth = getDocumentScrollDepth();
  }

  function clamp01(value) {
    return Math.max(0, Math.min(1, value));
  }

  function buildFrameScores(frame, ctaDistance, cursorIdleSeconds) {
    var nearCta = ctaDistance <= 220;
    var hoverCtaSeconds = (frame.zoneHoverMs.add_to_cart_zone || 0) / 1000;
    var hoverPolicySeconds =
      ((frame.zoneHoverMs.shipping_policy_zone || 0) + (frame.zoneHoverMs.return_policy_zone || 0)) / 1000;
    var hoverPriceSeconds = (frame.zoneHoverMs.price_zone || 0) / 1000;
    var hoverReviewsSeconds = (frame.zoneHoverMs.reviews_zone || 0) / 1000;
    var scrollDepth = frame.latestScrollDepth || 0;
    var mouseVelocityAvg = frame.mouseVelocitySamples > 0
      ? frame.mouseVelocitySum / frame.mouseVelocitySamples
      : 0;

    var intentScore = clamp01(
      (scrollDepth * 0.35) +
      (Math.min(hoverCtaSeconds, 2) / 2 * 0.3) +
      (nearCta ? 0.15 : 0) +
      (isCartPage() ? 0.2 : 0)
    );
    var frictionScore = clamp01(
      (frame.rageClickCount * 0.45) +
      (frame.deadClickCount * 0.3) +
      (hoverPolicySeconds * 0.16) +
      (nearCta && cursorIdleSeconds >= 1.5 ? 0.2 : 0)
    );
    var hesitationScore = clamp01(
      (hoverCtaSeconds >= 0.8 ? 0.35 : 0) +
      (cursorIdleSeconds >= 1 ? 0.25 : 0) +
      (nearCta ? 0.2 : 0) +
      (mouseVelocityAvg <= 0.05 ? 0.15 : 0)
    );
    var policyAnxietyScore = clamp01(
      (hoverPolicySeconds * 0.35) +
      ((frame.activeZone === "shipping_policy_zone" || frame.activeZone === "return_policy_zone") ? 0.25 : 0) +
      (isPolicyPage() ? 0.2 : 0)
    );
    var cartCommitmentScore = clamp01(
      (Math.min(hoverCtaSeconds, 2) / 2 * 0.35) +
      (nearCta ? 0.2 : 0) +
      (isCartPage() ? 0.35 : 0)
    );
    var abandonmentRiskScore = clamp01(
      (frictionScore * 0.45) +
      (hesitationScore * 0.35) +
      (policyAnxietyScore * 0.2) -
      (cartCommitmentScore * 0.2)
    );

    return {
      hoverCtaSeconds: hoverCtaSeconds,
      hoverPriceSeconds: hoverPriceSeconds,
      hoverPolicySeconds: hoverPolicySeconds,
      hoverReviewsSeconds: hoverReviewsSeconds,
      intentScore: intentScore,
      frictionScore: frictionScore,
      hesitationScore: hesitationScore,
      policyAnxietyScore: policyAnxietyScore,
      cartCommitmentScore: cartCommitmentScore,
      abandonmentRiskScore: abandonmentRiskScore
    };
  }

  function sendSessionFrame() {
    if (!shouldTrackSessionFrames() || !frameState) return;

    var now = Date.now();
    updateZoneHover(now, frameState.currentZone || "unknown_zone");
    var variant = getStoredVariant();
    if (variant !== "control" && variant !== "variant") return;

    var base = getBaseEventContext();
    var cursorIdleSeconds = Math.max(0, (now - (frameState.lastInteractionAt || now)) / 1000);
    var ctaDistance = getCtaDistance();
    var scores = buildFrameScores(frameState, ctaDistance, cursorIdleSeconds);
    var mouseVelocityAvg = frameState.mouseVelocitySamples > 0
      ? frameState.mouseVelocitySum / frameState.mouseVelocitySamples
      : 0;
    var mouseAccelerationAvg = frameState.mouseAccelerationSamples > 0
      ? frameState.mouseAccelerationSum / frameState.mouseAccelerationSamples
      : 0;
    var scrollVelocity = frameState.scrollVelocitySamples > 0
      ? frameState.scrollVelocitySum / frameState.scrollVelocitySamples
      : 0;
    var tSeconds = Math.max(0, Math.round((now - frameState.startedAtMs) / 1000));

    postJson("/api/events", {
      anonymous_id: getVisitorId(),
      session_id: getSessionId(),
      event_name: "session_frame",
      timestamp: Math.floor(now / 1000),
      properties: {
        shop_domain: CONFIG.shopDomain,
        path: window.location.pathname,
        referrer: base.referrer,
        experiment_variant: variant,
        device_type: base.device_type,
        template_name: base.template_name,
        currency: base.currency,
        product_id: base.product_id,
        product_handle: base.product_handle,
        cart_value: base.cart_value,
        client_event_id: createId("frame"),
        source: "storefront_session_frame",
        page_url: window.location.href,
        page_type: getPageTypeLabel(),
        journey_stage: getJourneyStageLabel(frameState),
        active_zone: frameState.activeZone || "unknown_zone",
        t_seconds: tSeconds,
        mouse_velocity_avg: Number(mouseVelocityAvg.toFixed(4)),
        mouse_velocity_max: Number(frameState.mouseVelocityMax.toFixed(4)),
        mouse_acceleration_avg: Number(mouseAccelerationAvg.toFixed(4)),
        mouse_distance: Number(frameState.mouseDistance.toFixed(2)),
        scroll_depth: Number((frameState.latestScrollDepth || 0).toFixed(4)),
        scroll_velocity: Number(scrollVelocity.toFixed(4)),
        cursor_idle_seconds: Number(cursorIdleSeconds.toFixed(3)),
        hover_cta_seconds: Number(scores.hoverCtaSeconds.toFixed(3)),
        hover_price_seconds: Number(scores.hoverPriceSeconds.toFixed(3)),
        hover_policy_seconds: Number(scores.hoverPolicySeconds.toFixed(3)),
        hover_reviews_seconds: Number(scores.hoverReviewsSeconds.toFixed(3)),
        cta_distance: Number(ctaDistance.toFixed(2)),
        click_count: frameState.clickCount,
        rage_click_count: frameState.rageClickCount,
        dead_click_count: frameState.deadClickCount,
        intent_score: Number(scores.intentScore.toFixed(4)),
        friction_score: Number(scores.frictionScore.toFixed(4)),
        hesitation_score: Number(scores.hesitationScore.toFixed(4)),
        policy_anxiety_score: Number(scores.policyAnxietyScore.toFixed(4)),
        cart_commitment_score: Number(scores.cartCommitmentScore.toFixed(4)),
        abandonment_risk_score: Number(scores.abandonmentRiskScore.toFixed(4))
      }
    }).catch(function () {});

    frameState = createFrameState();
  }

  function startSessionFrameTelemetry() {
    if (frameTelemetryStarted) return;
    frameTelemetryStarted = true;
    if (!frameSessionStartedAtMs) {
      frameSessionStartedAtMs = Date.now();
    }
    frameState = createFrameState(frameState);

    document.addEventListener("mousemove", updateFramePointer, { passive: true });
    window.addEventListener("scroll", updateFrameScroll, { passive: true });
    document.addEventListener("click", trackFrameClick, true);
    document.addEventListener("visibilitychange", function () {
      if (document.visibilityState === "hidden") {
        sendSessionFrame();
      }
    });
    window.addEventListener("pagehide", sendSessionFrame);

    frameTimer = window.setInterval(function () {
      sendSessionFrame();
    }, SESSION_FRAME_INTERVAL_MS);
  }

  function isHomePage() {
    return CONFIG.pageType === "index" || window.location.pathname === "/";
  }

  function isCollectionPage() {
    return CONFIG.pageType === "collection" || window.location.pathname.indexOf("/collections/") === 0;
  }

  function isSupportedInteractionPage() {
    return isHomePage() || isProductPage() || isCollectionPage();
  }

  function getInteractionConfig(eventType, reason, messageId) {
    var resolvedEventType = eventType;
    if (!resolvedEventType) {
      if (isProductPage()) {
        resolvedEventType = "product_view";
      } else if (isCollectionPage()) {
        resolvedEventType = "page_view";
      } else {
        resolvedEventType = "page_view";
      }
    }
    var resolvedMessageId = resolveInterventionMessageId(resolvedEventType, messageId);

    return {
      eventType: resolvedEventType,
      messageId: resolvedMessageId,
      reason: reason || "behavioral_intercept",
      message: INTERVENTION_MESSAGE_MATRIX[resolvedMessageId] || INTERVENTION_MESSAGE_MATRIX.tidio_cohort_v1
    };
  }

  function ensureFallbackUi() {
    if (fallbackUiMounted) return document.getElementById("behavioral-pro-fallback");

    try {
      if (!document.getElementById("behavioral-pro-fallback-style")) {
        var style = document.createElement("style");
        style.id = "behavioral-pro-fallback-style";
        style.textContent =
          "#behavioral-pro-fallback{position:fixed;right:16px;bottom:16px;z-index:2147483647;max-width:320px;background:#111827;color:#fff;border-radius:16px;box-shadow:0 16px 40px rgba(17,24,39,.3);padding:16px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;border:1px solid rgba(255,255,255,.12)}" +
          "#behavioral-pro-fallback[hidden]{display:none!important}" +
          "#behavioral-pro-fallback h3{margin:0 0 8px;font-size:16px;line-height:1.3}" +
          "#behavioral-pro-fallback p{margin:0 0 12px;font-size:14px;line-height:1.5;color:rgba(255,255,255,.84)}" +
          "#behavioral-pro-fallback button{appearance:none;border:0;border-radius:999px;padding:10px 14px;font-size:13px;font-weight:600;cursor:pointer}" +
          "#behavioral-pro-fallback .behavioral-pro-primary{background:#facc15;color:#111827}" +
          "#behavioral-pro-fallback .behavioral-pro-secondary{background:transparent;color:#fff;border:1px solid rgba(255,255,255,.28);margin-left:8px}";

        (document.head || document.documentElement).appendChild(style);
      }

      var wrapper = document.createElement("div");
      wrapper.id = "behavioral-pro-fallback";
      wrapper.hidden = true;
      wrapper.innerHTML =
        '<h3>BehavioralPro Assistant</h3>' +
        '<p id="behavioral-pro-fallback-copy"></p>' +
        '<button type="button" class="behavioral-pro-primary" id="behavioral-pro-fallback-open">Open help</button>' +
        '<button type="button" class="behavioral-pro-secondary" id="behavioral-pro-fallback-dismiss">Dismiss</button>';

      (document.body || document.documentElement).appendChild(wrapper);
      fallbackUiMounted = true;

      var dismissButton = document.getElementById("behavioral-pro-fallback-dismiss");
      if (dismissButton) {
        dismissButton.addEventListener("click", function () {
          wrapper.hidden = true;
        });
      }

      var openButton = document.getElementById("behavioral-pro-fallback-open");
      if (openButton) {
        openButton.addEventListener("click", function () {
          wrapper.hidden = false;
        });
      }

      return wrapper;
    } catch (e) {
      warn("Failed to mount fallback UI", e);
      return null;
    }
  }

  function showFallbackUi(copy) {
    var wrapper = ensureFallbackUi();
    if (!wrapper) return false;

    var copyNode = document.getElementById("behavioral-pro-fallback-copy");
    if (copyNode) {
      copyNode.textContent = copy;
    }

    wrapper.hidden = false;
    return true;
  }

  function shouldTriggerInteractionForEvent(eventName) {
    return (
      eventName === "page_view" ||
      eventName === "product_view" ||
      eventName === "policy_page_view" ||
      eventName === "coupon_field_focus" ||
      eventName === "cta_idle_15s" ||
      eventName === "rage_click" ||
      eventName === "exit_intent" ||
      eventName === "add_to_cart" ||
      eventName === "begin_checkout" ||
      eventName === "checkout_back"
    );
  }

  function shouldDelayInteractionForReviewMode(eventName) {
    return (
      eventName === "page_view" ||
      eventName === "product_view"
    );
  }

  function ensureGTM(gtmId) {
    if (!gtmId) return;
    if (document.getElementById("behavioral-pro-gtm-loader")) return;

    try {
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({
        "gtm.start": new Date().getTime(),
        event: "gtm.js"
      });

      var firstScript = document.getElementsByTagName("script")[0];
      var script = document.createElement("script");
      script.async = true;
      script.src = "https://www.googletagmanager.com/gtm.js?id=" + encodeURIComponent(gtmId);
      script.id = "behavioral-pro-gtm-loader";

      if (firstScript && firstScript.parentNode) {
        firstScript.parentNode.insertBefore(script, firstScript);
      } else if (document.head) {
        document.head.appendChild(script);
      }

      log("GTM requested");
    } catch (e) {
      warn("GTM failed to initialize", e);
    }
  }

  function ensureGA4(gaId) {
    if (!gaId) return;

    try {
      window.dataLayer = window.dataLayer || [];

      if (typeof window.gtag !== "function") {
        window.gtag = function () {
          window.dataLayer.push(arguments);
        };
      }

      if (!document.getElementById("behavioral-pro-ga4-loader")) {
        var script = document.createElement("script");
        script.async = true;
        script.src = "https://www.googletagmanager.com/gtag/js?id=" + encodeURIComponent(gaId);
        script.id = "behavioral-pro-ga4-loader";

        if (document.head) {
          document.head.appendChild(script);
        }
      }

      if (!window.__behavioralProGA4Configured) {
        window.gtag("js", new Date());
        window.gtag("config", gaId, {
          send_page_view: false
        });
        window.__behavioralProGA4Configured = true;
      }

      log("GA4 requested/configured");
    } catch (e) {
      warn("GA4 failed to initialize", e);
    }
  }

  function loadTidio() {
    if (!CONFIG.tidioId || tidioRequested) return;
    if (document.getElementById("behavioral-pro-tidio-loader")) return;

    tidioRequested = true;

    try {
      var script = document.createElement("script");
      script.async = true;
      script.src = "https://code.tidio.co/" + encodeURIComponent(CONFIG.tidioId) + ".js";
      script.id = "behavioral-pro-tidio-loader";
      script.onload = function () {
        log("Tidio loaded");
        bindTidioOpenTracking();
      };
      script.onerror = function (event) {
        tidioFailed = true;
        warn("Tidio failed to load");
        errorLog("BehavioralPro Tidio error", event);
      };

      if (document.body) {
        document.body.appendChild(script);
      } else if (document.head) {
        document.head.appendChild(script);
      }

      log("Requested Tidio load");
    } catch (e) {
      warn("Error requesting Tidio", e);
    }
  }

  function maybeLoadTidioForVariant(variant) {
    if (!CONFIG.tidioEnabled) return;
    if (variant === "variant" || CONFIG.reviewMode) loadTidio();
  }

  function trackTidioWidgetOpen(extra) {
    var metadata = extra || {};
    var dedupeKey = metadata.dedupe_key || ("tidio_widget_open:" + (metadata.source || "unknown"));
    if (shouldSuppressEventSignature(dedupeKey, MEDIUM_EVENT_DEBOUNCE_MS)) return;
    rememberEventSignature(dedupeKey);

    trackEvent("tidio_widget_open", metadata);
  }

  function bindTidioOpenTracking() {
    if (tidioOpenBindingRequested) return;
    tidioOpenBindingRequested = true;

    document.addEventListener("click", function (event) {
      try {
        var target = event.target;
        if (!target || !target.closest) return;

        var launcher = target.closest(
          '[id*="tidio"], [class*="tidio"], [data-tidio], [aria-label*="chat" i], [aria-label*="tidio" i]'
        );
        if (!launcher) return;

        trackTidioWidgetOpen({
          dedupe_key: "tidio_widget_open:launcher:" + window.location.pathname,
          source: "launcher_click"
        });
      } catch (e) {
        warn("Tidio launcher tracking failed", e);
      }
    }, true);
  }

  function ensureVariant(sessionId) {
    var existing = getStoredVariant();
    var visitorId = getVisitorId();
    if (existing) {
      assignmentReady = true;
      maybeLoadTidioForVariant(existing);
      return Promise.resolve(existing);
    }

    if (assignmentPromise) return assignmentPromise;

    assignmentPromise = postJson("/api/assign-variant", {
      shop_domain: CONFIG.shopDomain,
      session_id: sessionId,
      visitor_id: visitorId,
      page_url: window.location.href,
      referrer: document.referrer || null,
      experiment_name: CONFIG.experimentName
    })
      .then(function (response) {
        if (!response.ok) throw new Error("assign_failed");
        return response.json();
      })
      .then(function (json) {
        var variant = json && json.data && json.data.variant;

        if (variant !== "control" && variant !== "variant") {
          throw new Error("invalid_variant");
        }

        setStoredVariant(variant);
        assignmentReady = true;
        maybeLoadTidioForVariant(variant);
        log("Backend assigned variant:", variant);
        return variant;
      })
      .catch(function (err) {
        backendFailed = true;
        var fallbackVariant = getOrCreateFallbackVariant();
        setStoredVariant(fallbackVariant);
        assignmentReady = true;
        maybeLoadTidioForVariant(fallbackVariant);
        warn("Backend assignment failed, using fallback:", fallbackVariant, err);
        errorLog("BehavioralPro backend error", err);
        return fallbackVariant;
      });

    return assignmentPromise;
  }

  function buildPayload(eventName, variant, visitorId, sessionId, extra) {
    if (!ALLOWED_EVENT_NAMES[eventName]) {
      throw new Error("unsupported_event_name:" + eventName);
    }

    var context = getBaseEventContext();
    var metadata = Object.assign({}, context, extra || {});

    return {
      event_name: eventName,
      shop_domain: CONFIG.shopDomain,
      session_id: sessionId,
      visitor_id: visitorId,
      experiment_variant: variant,
      page_url: window.location.href,
      referrer: context.referrer,
      client_timestamp: nowIso(),
      event_id: createId("evt"),
      metadata: metadata
    };
  }

  function buildDataLayerEvent(payload) {
    return {
      event: payload.event_name,
      event_name: payload.event_name,
      experiment_name: CONFIG.experimentName,
      experiment_group: payload.experiment_variant === "variant" ? "experiment" : "control",
      variant: payload.experiment_variant,
      visitor_id: payload.visitor_id,
      session_id: payload.session_id,
      shop_domain: payload.shop_domain,
      event_id: payload.event_id,
      page_location: payload.page_url,
      page_path: window.location.pathname,
      page_type: CONFIG.pageType,
      timestamp: payload.client_timestamp,
      extra: payload.metadata
    };
  }

  function pushDataLayer(payload) {
    if (!CONFIG.legacyMirrorsEnabled) return;
    try {
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push(buildDataLayerEvent(payload));
    } catch (e) {
      warn("dataLayer push failed", e);
    }
  }

  function trackGA4Event(payload) {
    if (!CONFIG.legacyMirrorsEnabled) return;
    try {
      if (typeof window.gtag !== "function") return;

      window.gtag("event", payload.event_name, {
        experiment_name: CONFIG.experimentName,
        experiment_group: payload.experiment_variant === "variant" ? "experiment" : "control",
        variant: payload.experiment_variant,
        visitor_id: payload.visitor_id,
        session_id: payload.session_id,
        shop_domain: payload.shop_domain,
        event_id: payload.event_id,
        page_location: payload.page_url,
        page_path: window.location.pathname,
        page_type: CONFIG.pageType,
        timestamp: payload.client_timestamp
      });
    } catch (e) {
      warn("GA4 event failed", e);
    }
  }

  function maybeTriggerBehavioralUi(eventType, reason, messageId) {
    if (!CONFIG.active) return;
    if (
      Array.isArray(CONFIG.allowedInterventionTypes) &&
      CONFIG.allowedInterventionTypes.length > 0 &&
      CONFIG.allowedInterventionTypes.indexOf(eventType) === -1 &&
      eventType !== "review_mode" &&
      eventType !== "fallback"
    ) {
      log("Intervention blocked by storefront config:", eventType);
      return;
    }

    var interaction = getInteractionConfig(eventType, reason || "tidio_behavioral_intercept", messageId);
    var dedup = CONFIG.uiPrefix + ":" + interaction.eventType;
    if (shouldSuppressOncePerSession(dedup)) return;
    rememberEventSignature(dedup);

    var usedTidio = false;

    try {
      if (window.tidioChatApi) {
        if (interaction.messageId && typeof window.tidioChatApi.display === "function") {
          window.tidioChatApi.display(interaction.messageId);
          usedTidio = true;
        }
        if (typeof window.tidioChatApi.show === "function") {
          window.tidioChatApi.show();
          usedTidio = true;
        }
        if (typeof window.tidioChatApi.messageFromOperator === "function") {
          window.tidioChatApi.messageFromOperator(interaction.message);
          usedTidio = true;
        }
      }

      if (!usedTidio) {
        tidioFailed = true;
        log("tidioChatApi not ready for", interaction.eventType);
        return;
      }

      interactionDisplayed = true;
      info("BehavioralPro interaction displayed");
      trackEvent("intervention_triggered", {
        dedupe_key: dedup,
        intervention_type: interaction.eventType,
        message_name: interaction.messageId,
        reason: interaction.reason,
        message_copy: interaction.message,
        delivery: "tidio"
      });
      trackEvent("intervention_type", {
        dedupe_key: dedup + ":type",
        intervention_type: interaction.eventType,
        message_name: interaction.messageId,
        delivery: "tidio"
      });
      log("Triggered UI for", interaction.eventType, "via Tidio", interaction.messageId || "no_message_id");
    } catch (e) {
      tidioFailed = true;
      warn("Failed to trigger UI", e);
      errorLog("BehavioralPro Tidio error", e);
    }
  }

  async function shouldIntervene(sessionId, eventType, metadata) {
    var variant = getStoredVariant();
    if ((variant !== "variant" && !CONFIG.reviewMode) || interactionDisplayed || decisionRequestInFlight) {
      return { decision: false };
    }

    if (isCircuitBroken()) {
      return buildSilentFallbackDecision();
    }

    decisionRequestInFlight = true;
    var timeoutId = null;

    try {
      var controller = typeof window.AbortController === "function" ? new window.AbortController() : null;
      var timeoutPromise = new Promise(function (_, reject) {
        timeoutId = window.setTimeout(function () {
          try {
            if (controller) {
              controller.abort();
            }
          } catch (abortError) {}
          reject(new Error("intervention_decision_timeout"));
        }, DECISION_REQUEST_TIMEOUT_MS);
      });

      var response = await Promise.race([
        postJson("/api/intervention-decision", {
        shop_domain: CONFIG.shopDomain,
        session_id: sessionId,
        event_name: eventType,
        metadata: metadata || {}
      }, {
        signal: controller ? controller.signal : undefined
        }),
        timeoutPromise
      ]);

      if (!response || response.status !== 200) {
        var statusError = new Error("intervention_decision_failed_status:" + (response && typeof response.status === "number" ? response.status : "unknown"));
        recordDecisionFailure(statusError);
        lastDecisionStrategy = SILENT_FALLBACK_REASON;
        return buildSilentFallbackDecision();
      }

      var json = await response.json();
      if (
        !json ||
        typeof json !== "object" ||
        typeof json.decision !== "boolean" ||
        typeof json.strategy !== "string" ||
        typeof json.shadow_mode !== "boolean"
      ) {
        recordDecisionFailure(new Error("intervention_decision_invalid_payload"));
        lastDecisionStrategy = SILENT_FALLBACK_REASON;
        return buildSilentFallbackDecision();
      }

      resetDecisionFailureCount();
      lastDecisionStrategy = json && json.strategy ? json.strategy : null;
      var interventionType = json && json.intervention_type ? json.intervention_type : (eventType || "page_view");
      var decisionReason =
        json &&
        json.metadata &&
        typeof json.metadata === "object" &&
        typeof json.metadata.reason === "string"
          ? json.metadata.reason
          : (json && json.strategy ? json.strategy : "backend_decision");
      if (decisionReason === "cart_abandonment_detected" || interventionType === "cart_recovery") {
        await snapshotActiveCart();
      }

      if (json && json.shadow_mode) {
        log("Shadow intervention:", eventType || "unknown_event", lastDecisionStrategy || "no_strategy", json.message_id || "no_message_id");
        return { decision: false };
      }

      if (!json || !json.decision) {
        log("Decision held:", eventType || "unknown_event", lastDecisionStrategy || "no_strategy", json && json.message_id ? json.message_id : "no_message_id");
        return { decision: false };
      }

      log("Decision approved:", interventionType, lastDecisionStrategy || "no_strategy", json.message_id || "no_message_id");
      maybeTriggerBehavioralUi(interventionType, decisionReason, json.message_id || null);
      return json;
    } catch (err) {
      recordDecisionFailure(err);
      lastDecisionStrategy = SILENT_FALLBACK_REASON;
      return buildSilentFallbackDecision();
    } finally {
      if (timeoutId) {
        window.clearTimeout(timeoutId);
      }
      decisionRequestInFlight = false;
    }
  }

  function scheduleDecisionCheck(triggerEventName, metadata) {
    if (interactionDisplayed || decisionRequestInFlight) return;
    if (!shouldTriggerInteractionForEvent(triggerEventName)) return;

    if (pendingDecisionCheck) {
      window.clearTimeout(pendingDecisionCheck);
      pendingDecisionCheck = null;
    }

    pendingDecisionCheck = window.setTimeout(function () {
      pendingDecisionCheck = null;

      if (interactionDisplayed || decisionRequestInFlight) return;

      var variant = getStoredVariant();
      if (variant !== "variant" && !CONFIG.reviewMode) return;

      shouldIntervene(getSessionId(), triggerEventName, metadata || {});
    }, 350);
  }

  function trackEvent(eventName, extra) {
    var sessionId = getSessionId();
    var visitorId = getVisitorId();

    if (!assignmentReady) {
      log("Skipped event before assignment was ready:", eventName);
      return;
    }

    var variant = getStoredVariant();
    if (variant !== "control" && variant !== "variant") {
      warn("No stored variant when trying to send event:", eventName);
      return;
    }

    var payload = buildPayload(eventName, variant, visitorId, sessionId, extra);

    pushDataLayer(payload);
    trackGA4Event(payload);

    postJson("/api/events", {
      anonymous_id: payload.visitor_id,
      session_id: payload.session_id,
      event_name: payload.event_name,
      timestamp: Math.floor(new Date(payload.client_timestamp).getTime() / 1000),
      properties: Object.assign({}, payload.metadata || {}, {
        client_event_id: payload.event_id,
        path: window.location.pathname,
        shop_domain: payload.shop_domain,
        referrer: payload.referrer,
        experiment_variant: payload.experiment_variant
      })
    })
    .then(function (response) {
      if (!response.ok) {
        throw new Error("events_failed_status:" + response.status);
      }
      log("Sent event:", eventName, variant);
    })
    .catch(function (err) {
      warn("Event send failed:", eventName, err);
      errorLog("BehavioralPro backend error", err);
    });

    if (
      eventName !== "intervention_triggered" &&
      eventName !== "intervention_type" &&
      (variant === "variant" || CONFIG.reviewMode) &&
      !(CONFIG.reviewMode && shouldDelayInteractionForReviewMode(eventName))
    ) {
      scheduleDecisionCheck(eventName, extra);
    }
  }

  function isProductPage() {
    return CONFIG.pageType === "product" || window.location.pathname.indexOf("/products/") === 0;
  }

  function isAddToCartTarget(target) {
    if (!target || !target.closest) return false;

    var form = target.closest('form[action*="/cart/add"]');
    if (form) return true;

    var el = target.closest('button, input[type="submit"], input[type="button"], a');
    if (!el) return false;

    var text = String(
      (el.textContent || "") + " " +
      (el.value || "") + " " +
      (el.getAttribute("name") || "") + " " +
      (el.getAttribute("aria-label") || "") + " " +
      (el.id || "") + " " +
      (typeof el.className === "string" ? el.className : "")
    ).toLowerCase();

    return (
      text.indexOf("add to cart") !== -1 ||
      text.indexOf("add-to-cart") !== -1 ||
      text.indexOf("add to bag") !== -1 ||
      text.indexOf("buy now") !== -1
    );
  }

  function hasAddToCartFormAncestor(target) {
    return !!(target && target.closest && target.closest('form[action*="/cart/add"]'));
  }

  function isBeginCheckoutTarget(target) {
    if (!target || !target.closest) return false;

    var form = target.closest('form[action*="/checkout"]');
    if (form) return true;

    var link = target.closest('a[href*="/checkout"], button[name="checkout"], input[name="checkout"]');
    if (link) return true;

    var el = target.closest('button, input[type="submit"], input[type="button"], a');
    if (!el) return false;

    var text = String(
      (el.textContent || "") + " " +
      (el.value || "") + " " +
      (el.getAttribute("name") || "") + " " +
      (el.getAttribute("aria-label") || "") + " " +
      (el.id || "") + " " +
      (typeof el.className === "string" ? el.className : "")
    ).toLowerCase();

    return (
      text.indexOf("checkout") !== -1 ||
      text.indexOf("check out") !== -1 ||
      text.indexOf("secure checkout") !== -1
    );
  }

  function hasCheckoutFormAncestor(target) {
    return !!(target && target.closest && target.closest('form[action*="/checkout"]'));
  }

  function isCartOpenTarget(target) {
    var el = target && target.closest ? target.closest('button, a, summary, [role="button"]') : null;
    if (!el) return false;

    var text = String(
      (el.textContent || "") + " " +
      (el.getAttribute("aria-label") || "") + " " +
      (el.getAttribute("data-cart-action") || "") + " " +
      (el.id || "") + " " +
      (typeof el.className === "string" ? el.className : "")
    ).toLowerCase();

    return text.indexOf("cart") !== -1 && (
      text.indexOf("open") !== -1 ||
      text.indexOf("bag") !== -1 ||
      text.indexOf("drawer") !== -1 ||
      text.indexOf("mini-cart") !== -1
    );
  }

  function isCartCloseTarget(target) {
    var el = target && target.closest ? target.closest('button, a, [role="button"]') : null;
    if (!el) return false;

    var text = String(
      (el.textContent || "") + " " +
      (el.getAttribute("aria-label") || "") + " " +
      (el.getAttribute("data-cart-action") || "") + " " +
      (el.id || "") + " " +
      (typeof el.className === "string" ? el.className : "")
    ).toLowerCase();

    return text.indexOf("cart") !== -1 && (
      text.indexOf("close") !== -1 ||
      text.indexOf("hide") !== -1 ||
      text.indexOf("dismiss") !== -1
    );
