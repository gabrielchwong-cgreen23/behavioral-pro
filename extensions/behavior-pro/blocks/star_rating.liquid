{% schema %}
{
  "name": "BehavioralPro",
  "target": "head",
  "settings": [
    {
      "type": "checkbox",
      "id": "expt_active",
      "label": "Run 14-Day Revenue Lift Test",
      "default": true
    },
    {
      "type": "text",
      "id": "backend_base",
      "label": "Backend Base URL",
      "default": "https://behavioral-pro-production.up.railway.app"
    },
    {
      "type": "checkbox",
      "id": "debug_mode",
      "label": "Enable Debug Logs",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "review_mode",
      "label": "Reviewer Demo Mode",
      "default": false
    },
    {
      "type": "range",
      "id": "review_delay_seconds",
      "label": "Reviewer Demo Delay (seconds)",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 3
    }
  ]
}
{% endschema %}

<script>
(function () {
  if (window.__behavioralProAgencyRevenueLiftLoaded) return;
  window.__behavioralProAgencyRevenueLiftLoaded = true;
  if (window.console && typeof window.console.log === "function") {
    window.console.log("BehavioralPro embed loaded");
  }

  var CONFIG = {
    active: {{ block.settings.expt_active | json }},
    backendBase: {{ block.settings.backend_base | json }},
    debug: {{ block.settings.debug_mode | json }},
    reviewModeSetting: {{ block.settings.review_mode | json }},
    reviewDelayMs: {{ block.settings.review_delay_seconds | times: 1000 | json }},
    shopDomain: {{ shop.domain | json }},
    pageType: {{ request.page_type | json }},
    templateName: {{ template.name | json }},
    currency: {{ shop.currency | json }},
    productId: {{ product.id | json }},
    productHandle: {{ product.handle | json }},
    cartValue: {{ cart.total_price | divided_by: 100.0 | json }},

    gtmId: "GTM-3H5SLT7T",
    ga4Id: "G-6TZYV1S6L9",
    tidioId: "63hgfq26munthk1pfvmvz25ryddkjgsf",
    experimentName: "agency_revenue_lift_14_day",
    legacyMirrorsEnabled: true,
    tidioEnabled: true,
    shadowMode: false,
    allowedInterventionTypes: [],
    cooldownSeconds: 300,

    sessionKey: "behavioral_pro_session_id",
    variantKey: "behavioral_pro_variant",
    fallbackVariantKey: "behavioral_pro_fallback_variant",
    visitorKey: "behavioral_pro_visitor_id",
    eventDedupKey: "behavioral_pro_event_dedup",
    purchasePrefix: "behavioral_pro_purchase_",
    uiPrefix: "behavioral_pro_ui_",
    pageViewKey: "behavioral_pro_page_view",
    productPageViewKey: "behavioral_pro_product_page_view",
    addToCartKey: "behavioral_pro_add_to_cart_click",
    checkoutKey: "behavioral_pro_begin_checkout_click"
  };

  var ALLOWED_EVENT_NAMES = {
    experiment_assignment: 1,
    page_view: 1,
    product_view: 1,
    add_to_cart: 1,
    cart_open: 1,
    cart_close: 1,
    begin_checkout: 1,
    checkout_back: 1,
    purchase: 1,
    coupon_field_focus: 1,
    discount_code_applied: 1,
    quantity_change: 1,
    variant_change: 1,
    policy_page_view: 1,
    scroll_depth_reached: 1,
    product_dwell_12s: 1,
    review_section_dwell_10s: 1,
    cta_idle_15s: 1,
    rage_click: 1,
    exit_intent: 1,
    tidio_widget_open: 1,
    intervention_triggered: 1,
    intervention_type: 1
  };

  if (!CONFIG.active) return;

  var assignmentPromise = null;
  var assignmentReady = false;
  var tidioRequested = false;
  var tidioOpenBindingRequested = false;
  var memorySessionId = null;
  var clickTrackingBound = false;
  var fallbackUiMounted = false;
  var interactionDisplayed = false;
  var backendFailed = false;
  var tidioFailed = false;
  var decisionRequestInFlight = false;
  var pendingDecisionCheck = null;
  var lastDecisionStrategy = null;
  var ctaIdleTimer = null;
  var ctaIdleTarget = null;
  var ctaInteracted = false;
  var rageClickBuffer = [];
  var reviewObserver = null;
  var reviewDwellTimer = null;
  var reviewDwellFired = false;
  var motionTrackerStarted = false;
  var STRICT_SESSION_DEDUPE_MS = 12 * 60 * 60 * 1000;
  var SHORT_EVENT_DEBOUNCE_MS = 1500;
  var MEDIUM_EVENT_DEBOUNCE_MS = 5000;

  function log() {
    if (!CONFIG.debug || !window.console || typeof window.console.log !== "function") return;
    try {
      var args = ["[BehavioralPro]"].concat([].slice.call(arguments));
      window.console.log.apply(window.console, args);
    } catch (e) {}
  }

  function warn() {
    if (!window.console || typeof window.console.warn !== "function") return;
    try {
      var args = ["[BehavioralPro]"].concat([].slice.call(arguments));
      window.console.warn.apply(window.console, args);
    } catch (e) {}
  }

  function info(message) {
    if (!window.console || typeof window.console.log !== "function") return;
    try {
      window.console.log(message);
    } catch (e) {}
  }

  function errorLog(message, error) {
    if (!window.console || typeof window.console.error !== "function") return;
    try {
      if (error) {
        window.console.error(message, error);
      } else {
        window.console.error(message);
      }
    } catch (e) {}
  }

  function safeGetLocalStorage(key) {
    try {
      return window.localStorage.getItem(key);
    } catch (e) {
      return null;
    }
  }

  function safeSetLocalStorage(key, value) {
    try {
      window.localStorage.setItem(key, value);
    } catch (e) {}
  }

  function getSessionStorage() {
    try {
      window.sessionStorage.setItem("__bp_test", "1");
      window.sessionStorage.removeItem("__bp_test");
      return window.sessionStorage;
    } catch (e) {
      return null;
    }
  }

  function safeGetSessionStorage(key) {
    try {
      return window.sessionStorage.getItem(key);
    } catch (e) {
      return null;
    }
  }

  function safeSetSessionStorage(key, value) {
    try {
      window.sessionStorage.setItem(key, value);
    } catch (e) {}
  }

  function nowIso() {
    return new Date().toISOString();
  }

  function getQueryParam(name) {
    try {
      return new URL(window.location.href).searchParams.get(name);
    } catch (e) {
      return null;
    }
  }

  function createId(prefix) {
    try {
      if (window.crypto && typeof window.crypto.randomUUID === "function") {
        return prefix + "_" + window.crypto.randomUUID();
      }
    } catch (e) {}

    return prefix + "_" + Math.random().toString(36).slice(2) + "_" + Date.now();
  }

  function getReviewModeFlag() {
    var flag = getQueryParam("behavioralpro_review");
    if (flag === "1" || flag === "true") {
      return true;
    }
    if (flag === "0" || flag === "false") {
      return false;
    }
    return false;
  }

  CONFIG.reviewMode = getReviewModeFlag();

  if (CONFIG.reviewMode) {
    info("BehavioralPro review mode active");
  }

  function getDeviceType() {
    var width = window.innerWidth || 0;
    if (width && width < 768) return "mobile";
    if (width && width < 1024) return "tablet";
    return "desktop";
  }

  function getTrafficSource() {
    var utmSource = getQueryParam("utm_source");
    if (utmSource) return utmSource;

    try {
      if (document.referrer) {
        return new URL(document.referrer).hostname || "referral";
      }
    } catch (e) {}

    return "direct";
  }

  function getBaseEventContext() {
    return {
      referrer: document.referrer || null,
      traffic_source: getTrafficSource(),
      device_type: getDeviceType(),
      product_id: CONFIG.productId || null,
      product_handle: CONFIG.productHandle || null,
      cart_value: typeof CONFIG.cartValue === "number" ? CONFIG.cartValue : null,
      template_name: CONFIG.templateName || null,
      currency: CONFIG.currency || null
    };
  }

  function createSessionId() {
    var randomPart = "";

    try {
      if (window.crypto && typeof window.crypto.randomUUID === "function") {
        randomPart = window.crypto.randomUUID().replace(/-/g, "");
      } else if (window.crypto && typeof window.crypto.getRandomValues === "function") {
        var array = new Uint32Array(4);
        window.crypto.getRandomValues(array);
        randomPart = Array.prototype.map.call(array, function (part) {
          return part.toString(36);
        }).join("");
      }
    } catch (e) {}

    if (!randomPart) {
      randomPart = Math.random().toString(36).slice(2) + Date.now().toString(36);
    }

    return "session_" + randomPart;
  }

  function getVisitorId() {
    var existing = safeGetLocalStorage(CONFIG.visitorKey);
    if (existing) return existing;

    var id = createId("v");
    safeSetLocalStorage(CONFIG.visitorKey, id);
    return id;
  }

  function getSessionId() {
    var sessionStorageRef = getSessionStorage();

    if (sessionStorageRef) {
      var existingSession = sessionStorageRef.getItem(CONFIG.sessionKey);
      if (existingSession) return existingSession;

      var newSessionId = createSessionId();
      try {
        sessionStorageRef.setItem(CONFIG.sessionKey, newSessionId);
      } catch (e) {}
      return newSessionId;
    }

    if (!memorySessionId) {
      memorySessionId = createSessionId();
    }

    return memorySessionId;
  }

  function getStoredVariant() {
    var sessionStorageRef = getSessionStorage();
    if (!sessionStorageRef) return null;

    var variant = sessionStorageRef.getItem(CONFIG.variantKey);
    return variant === "control" || variant === "variant" ? variant : null;
  }

  function setStoredVariant(variant) {
    if (variant !== "control" && variant !== "variant") return;

    var sessionStorageRef = getSessionStorage();
    if (!sessionStorageRef) return;

    try {
      sessionStorageRef.setItem(CONFIG.variantKey, variant);
    } catch (e) {}
  }

  function getFallbackVariant() {
    var sessionStorageRef = getSessionStorage();
    if (!sessionStorageRef) return null;

    var variant = sessionStorageRef.getItem(CONFIG.fallbackVariantKey);
    return variant === "control" || variant === "variant" ? variant : null;
  }

  function setFallbackVariant(variant) {
    if (variant !== "control" && variant !== "variant") return;

    var sessionStorageRef = getSessionStorage();
    if (!sessionStorageRef) return;

    try {
      sessionStorageRef.setItem(CONFIG.fallbackVariantKey, variant);
    } catch (e) {}
  }

  function getOrCreateFallbackVariant() {
    var existing = getFallbackVariant();
    if (existing) return existing;

    var variant = Math.random() < 0.5 ? "control" : "variant";
    setFallbackVariant(variant);
    return variant;
  }

  function getEventDedupMap() {
    var raw = safeGetSessionStorage(CONFIG.eventDedupKey);
    if (!raw) return {};

    try {
      var parsed = JSON.parse(raw);
      return parsed && typeof parsed === "object" ? parsed : {};
    } catch (e) {
      return {};
    }
  }

  function setEventDedupMap(map) {
    safeSetSessionStorage(CONFIG.eventDedupKey, JSON.stringify(map || {}));
  }

  function pruneEventDedupMap(map, now) {
    var next = map || {};
    var currentTime = typeof now === "number" ? now : Date.now();
    Object.keys(next).forEach(function (key) {
      var value = Number(next[key] || 0);
      if (!value || currentTime - value > STRICT_SESSION_DEDUPE_MS) {
        delete next[key];
      }
    });
    return next;
  }

  function getEventDedupTimestamp(signature) {
    var map = getEventDedupMap();
    return Number(map[signature] || 0);
  }

  function rememberEventSignature(signature) {
    var map = getEventDedupMap();
    var now = Date.now();
    map[signature] = now;
    pruneEventDedupMap(map, now);
    setEventDedupMap(map);
  }

  function shouldSuppressEventSignature(signature, windowMs) {
    var lastSeenAt = getEventDedupTimestamp(signature);
    if (!lastSeenAt) return false;

    var ttl = Number(windowMs || 0);
    if (ttl <= 0) return false;

    return (Date.now() - lastSeenAt) < ttl;
  }

  function shouldSuppressOncePerSession(signature) {
    return shouldSuppressEventSignature(signature, STRICT_SESSION_DEDUPE_MS);
  }

  function shouldSuppressRapidDuplicate(signature) {
    return shouldSuppressEventSignature(signature, SHORT_EVENT_DEBOUNCE_MS);
  }

  function normalizeBaseUrl(url) {
    return String(url || "").replace(/\/+$/, "");
  }

  function isUsableBackendBase(base) {
    if (!base) return false;
    if (base.indexOf("localhost") !== -1) return false;
    if (base.indexOf("127.0.0.1") !== -1) return false;
    return true;
  }

  function postJson(path, body, options) {
    var base = normalizeBaseUrl(CONFIG.backendBase);
    var requestOptions = options || {};

    if (typeof window.fetch !== "function" || !isUsableBackendBase(base)) {
      return Promise.reject(new Error("backend_unavailable"));
    }

    return window.fetch(base + path, {
      method: "POST",
      headers: {
        "Content-Type": "application/json"
      },
      body: JSON.stringify(body),
      keepalive: true,
      credentials: "omit",
      mode: "cors",
      signal: requestOptions.signal
    }).then(function (response) {
      if (response.redirected) {
        throw new Error("redirected_request:" + response.status);
      }
      return response;
    });
  }

  function postJsonBeacon(path, body) {
    var base = normalizeBaseUrl(CONFIG.backendBase);

    if (!isUsableBackendBase(base)) {
      return false;
    }

    var payload = JSON.stringify(body);

    if (typeof navigator !== "undefined" && typeof navigator.sendBeacon === "function") {
      try {
        if (navigator.sendBeacon(base + path, new Blob([payload], { type: "application/json" }))) {
          return true;
        }
      } catch (e) {}
    }

    if (typeof window.fetch === "function") {
      window.fetch(base + path, {
        method: "POST",
        headers: {
          "Content-Type": "application/json"
        },
        body: payload,
        keepalive: true,
        credentials: "omit",
        mode: "cors"
      }).catch(function () {});
      return true;
    }

    return false;
  }

  function encodeByteArrayBase64(bytes) {
    var binary = "";
    var chunkSize = 8192;
    var index = 0;

    while (index < bytes.length) {
      binary += String.fromCharCode.apply(null, bytes.subarray(index, index + chunkSize));
      index += chunkSize;
    }

    return window.btoa(binary);
  }

  function startPackedMotionTracking() {
    if (motionTrackerStarted || !assignmentReady) return;
    motionTrackerStarted = true;

    var SAMPLE_BYTES = 14;
    var MAX_SAMPLES = 128;
    var FLUSH_MS = 100;
    var EVENT_NAME = "mouse_path_batch";
    var buffer = new ArrayBuffer(SAMPLE_BYTES * MAX_SAMPLES);
    var view = new DataView(buffer);
    var count = 0;
    var baseTs = 0;
    var lastX = 0;
    var lastY = 0;
    var lastScrollX = Math.max(0, window.scrollX || 0);
    var lastScrollY = Math.max(0, window.scrollY || 0);

    function clampU16(value) {
      value = value | 0;
      if (value < 0) return 0;
      if (value > 65535) return 65535;
      return value;
    }

    function clampU32(value) {
      value = Math.floor(Number(value) || 0);
      if (value < 0) return 0;
      if (value > 4294967295) return 4294967295;
      return value;
    }

    function flush() {
      if (!count || !assignmentReady) return;

      var variant = getStoredVariant();
      if (variant !== "control" && variant !== "variant") return;

      var visitorId = getVisitorId();
      var sessionId = getSessionId();
      var context = getBaseEventContext();
      var byteLength = count * SAMPLE_BYTES;
      var bytes = new Uint8Array(buffer, 0, byteLength);
      var sentAt = Date.now();

      postJsonBeacon("/api/events", {
        anonymous_id: visitorId,
        session_id: sessionId,
        event_name: EVENT_NAME,
        timestamp: Math.floor(baseTs / 1000),
        experiment_variant: variant,
        properties: {
          referrer: context.referrer,
          traffic_source: context.traffic_source,
          device_type: context.device_type,
          product_id: context.product_id,
          product_handle: context.product_handle,
          cart_value: context.cart_value,
          template_name: context.template_name,
          currency: context.currency,
          shop_domain: CONFIG.shopDomain,
          path: window.location.pathname,
          experiment_variant: variant,
          client_event_id: createId("evt"),
          timeseries_block: {
            version: 1,
            kind: "mouse_pointer_scroll",
            encoding: "base64",
            endian: "LE",
            stride_bytes: SAMPLE_BYTES,
            sample_count: count,
            base_timestamp_ms: baseTs,
            flushed_timestamp_ms: sentAt,
            schema: ["u16:x", "u16:y", "u16:dt_ms", "u32:scroll_x", "u32:scroll_y"],
            data: encodeByteArrayBase64(bytes)
          }
        }
      });

      count = 0;
      baseTs = 0;
    }

    function pushSample(x, y, ts, scrollX, scrollY) {
      if (count >= MAX_SAMPLES) {
        flush();
      }

      if (!count) {
        baseTs = ts;
      }

      var offset = count * SAMPLE_BYTES;
      view.setUint16(offset, clampU16(x), true);
      view.setUint16(offset + 2, clampU16(y), true);
      view.setUint16(offset + 4, clampU16(ts - baseTs), true);
      view.setUint32(offset + 6, clampU32(scrollX), true);
      view.setUint32(offset + 10, clampU32(scrollY), true);
      count += 1;
    }

    function readScrollOffsets() {
      lastScrollX = Math.max(0, window.scrollX || document.documentElement.scrollLeft || 0);
      lastScrollY = Math.max(0, window.scrollY || document.documentElement.scrollTop || 0);
    }

    document.addEventListener("mousemove", function (event) {
      lastX = clampU16(event.clientX || 0);
      lastY = clampU16(event.clientY || 0);
      readScrollOffsets();
      pushSample(lastX, lastY, Date.now(), lastScrollX, lastScrollY);
    }, { passive: true });

    window.addEventListener("scroll", function () {
      readScrollOffsets();
      pushSample(lastX, lastY, Date.now(), lastScrollX, lastScrollY);
    }, { passive: true });

    window.setInterval(flush, FLUSH_MS);
    window.addEventListener("pagehide", flush);
    document.addEventListener("visibilitychange", function () {
      if (document.visibilityState === "hidden") {
        flush();
      }
    });
  }

  function getJson(path, params) {
    var base = normalizeBaseUrl(CONFIG.backendBase);

    if (typeof window.fetch !== "function" || !isUsableBackendBase(base)) {
      return Promise.reject(new Error("backend_unavailable"));
    }

    var url = new URL(base + path);
    Object.keys(params || {}).forEach(function (key) {
      var value = params[key];
      if (value == null || value === "") return;
      url.searchParams.set(key, String(value));
    });

    return window.fetch(url.toString(), {
      method: "GET",
      credentials: "omit",
      mode: "cors",
      cache: "no-store"
    }).then(function (response) {
      if (response.redirected) {
        throw new Error("redirected_request:" + response.status);
      }
      return response;
    });
  }

  function isHomePage() {
    return CONFIG.pageType === "index" || window.location.pathname === "/";
  }

  function isCollectionPage() {
    return CONFIG.pageType === "collection" || window.location.pathname.indexOf("/collections/") === 0;
  }

  function isSupportedInteractionPage() {
    return isHomePage() || isProductPage() || isCollectionPage();
  }

  function getInteractionConfig(eventType, reason) {
    var resolvedEventType = eventType;
    if (!resolvedEventType) {
      if (isProductPage()) {
        resolvedEventType = "product_view";
      } else if (isCollectionPage()) {
        resolvedEventType = "page_view";
      } else {
        resolvedEventType = "page_view";
      }
    }

    var messages = {
      page_view: "Hi there. If you'd like a hand getting started, I'm here.",
      product_view: "If you'd like a second opinion on this product, I can help.",
      add_to_cart: "Nice pick. If you have any questions before checkout, I'm here.",
      begin_checkout: "If anything feels unclear during checkout, I can help.",
      friction_assistance: "If anything on this page feels unclear, I'm happy to help.",
      cart_recovery: "If you'd like help deciding or have a quick question about your cart, I'm here.",
      checkout_recovery: "If you have any last-minute questions before checkout, I can help.",
      trust_reassurance: "Happy to help with shipping, returns, sizing, or product details.",
      fast_conversion_nudge: "If you'd like a quick recommendation, I can help.",
      reassurance_assist: "If you'd like a quick answer before you decide, I'm here.",
      high_touch_consultation: "If you'd like a more tailored recommendation, I'd be happy to help.",
      review_mode: "BehavioralPro review mode is active. Open chat to test the intervention.",
      fallback: "If you'd like a hand while you shop, I'm here."
    };

    return {
      eventType: resolvedEventType,
      reason: reason || "behavioral_intercept",
      message: messages[resolvedEventType] || messages.page_view
    };
  }

  function ensureFallbackUi() {
    if (fallbackUiMounted) return document.getElementById("behavioral-pro-fallback");

    try {
      if (!document.getElementById("behavioral-pro-fallback-style")) {
        var style = document.createElement("style");
        style.id = "behavioral-pro-fallback-style";
        style.textContent =
          "#behavioral-pro-fallback{position:fixed;right:16px;bottom:16px;z-index:2147483647;max-width:320px;background:#111827;color:#fff;border-radius:16px;box-shadow:0 16px 40px rgba(17,24,39,.3);padding:16px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;border:1px solid rgba(255,255,255,.12)}" +
          "#behavioral-pro-fallback[hidden]{display:none!important}" +
          "#behavioral-pro-fallback h3{margin:0 0 8px;font-size:16px;line-height:1.3}" +
          "#behavioral-pro-fallback p{margin:0 0 12px;font-size:14px;line-height:1.5;color:rgba(255,255,255,.84)}" +
          "#behavioral-pro-fallback button{appearance:none;border:0;border-radius:999px;padding:10px 14px;font-size:13px;font-weight:600;cursor:pointer}" +
          "#behavioral-pro-fallback .behavioral-pro-primary{background:#facc15;color:#111827}" +
          "#behavioral-pro-fallback .behavioral-pro-secondary{background:transparent;color:#fff;border:1px solid rgba(255,255,255,.28);margin-left:8px}";

        (document.head || document.documentElement).appendChild(style);
      }

      var wrapper = document.createElement("div");
      wrapper.id = "behavioral-pro-fallback";
      wrapper.hidden = true;
      wrapper.innerHTML =
        '<h3>BehavioralPro Assistant</h3>' +
        '<p id="behavioral-pro-fallback-copy"></p>' +
        '<button type="button" class="behavioral-pro-primary" id="behavioral-pro-fallback-open">Open help</button>' +
        '<button type="button" class="behavioral-pro-secondary" id="behavioral-pro-fallback-dismiss">Dismiss</button>';

      (document.body || document.documentElement).appendChild(wrapper);
      fallbackUiMounted = true;

      var dismissButton = document.getElementById("behavioral-pro-fallback-dismiss");
      if (dismissButton) {
        dismissButton.addEventListener("click", function () {
          wrapper.hidden = true;
        });
      }

      var openButton = document.getElementById("behavioral-pro-fallback-open");
      if (openButton) {
        openButton.addEventListener("click", function () {
          wrapper.hidden = false;
        });
      }

      return wrapper;
    } catch (e) {
      warn("Failed to mount fallback UI", e);
      return null;
    }
  }

  function showFallbackUi(copy) {
    var wrapper = ensureFallbackUi();
    if (!wrapper) return false;

    var copyNode = document.getElementById("behavioral-pro-fallback-copy");
    if (copyNode) {
      copyNode.textContent = copy;
    }

    wrapper.hidden = false;
    return true;
  }

  function shouldTriggerInteractionForEvent(eventName) {
    return (
      eventName === "page_view" ||
      eventName === "product_view" ||
      eventName === "policy_page_view" ||
      eventName === "coupon_field_focus" ||
      eventName === "cta_idle_15s" ||
      eventName === "rage_click" ||
      eventName === "exit_intent" ||
      eventName === "add_to_cart" ||
      eventName === "begin_checkout" ||
      eventName === "checkout_back"
    );
  }

  function shouldDelayInteractionForReviewMode(eventName) {
    return (
      eventName === "page_view" ||
      eventName === "product_view"
    );
  }

  function ensureGTM(gtmId) {
    if (!gtmId) return;
    if (document.getElementById("behavioral-pro-gtm-loader")) return;

    try {
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({
        "gtm.start": new Date().getTime(),
        event: "gtm.js"
      });

      var firstScript = document.getElementsByTagName("script")[0];
      var script = document.createElement("script");
      script.async = true;
      script.src = "https://www.googletagmanager.com/gtm.js?id=" + encodeURIComponent(gtmId);
      script.id = "behavioral-pro-gtm-loader";

      if (firstScript && firstScript.parentNode) {
        firstScript.parentNode.insertBefore(script, firstScript);
      } else if (document.head) {
        document.head.appendChild(script);
      }

      log("GTM requested");
    } catch (e) {
      warn("GTM failed to initialize", e);
    }
  }

  function ensureGA4(gaId) {
    if (!gaId) return;

    try {
      window.dataLayer = window.dataLayer || [];

      if (typeof window.gtag !== "function") {
        window.gtag = function () {
          window.dataLayer.push(arguments);
        };
      }

      if (!document.getElementById("behavioral-pro-ga4-loader")) {
        var script = document.createElement("script");
        script.async = true;
        script.src = "https://www.googletagmanager.com/gtag/js?id=" + encodeURIComponent(gaId);
        script.id = "behavioral-pro-ga4-loader";

        if (document.head) {
          document.head.appendChild(script);
        }
      }

      if (!window.__behavioralProGA4Configured) {
        window.gtag("js", new Date());
        window.gtag("config", gaId, {
          send_page_view: false
        });
        window.__behavioralProGA4Configured = true;
      }

      log("GA4 requested/configured");
    } catch (e) {
      warn("GA4 failed to initialize", e);
    }
  }

  function loadTidio() {
    if (!CONFIG.tidioId || tidioRequested) return;
    if (document.getElementById("behavioral-pro-tidio-loader")) return;

    tidioRequested = true;

    try {
      var script = document.createElement("script");
      script.async = true;
      script.src = "https://code.tidio.co/" + encodeURIComponent(CONFIG.tidioId) + ".js";
      script.id = "behavioral-pro-tidio-loader";
      script.onload = function () {
        log("Tidio loaded");
        bindTidioOpenTracking();
      };
      script.onerror = function (event) {
        tidioFailed = true;
        warn("Tidio failed to load");
        errorLog("BehavioralPro Tidio error", event);
      };

      if (document.body) {
        document.body.appendChild(script);
      } else if (document.head) {
        document.head.appendChild(script);
      }

      log("Requested Tidio load");
    } catch (e) {
      warn("Error requesting Tidio", e);
    }
  }

  function maybeLoadTidioForVariant(variant) {
    if (!CONFIG.tidioEnabled) return;
    if (variant === "variant" || CONFIG.reviewMode) loadTidio();
  }

  function trackTidioWidgetOpen(extra) {
    var metadata = extra || {};
    var dedupeKey = metadata.dedupe_key || ("tidio_widget_open:" + (metadata.source || "unknown"));
    if (shouldSuppressEventSignature(dedupeKey, MEDIUM_EVENT_DEBOUNCE_MS)) return;
    rememberEventSignature(dedupeKey);

    trackEvent("tidio_widget_open", metadata);
  }

  function bindTidioOpenTracking() {
    if (tidioOpenBindingRequested) return;
    tidioOpenBindingRequested = true;

    document.addEventListener("click", function (event) {
      try {
        var target = event.target;
        if (!target || !target.closest) return;

        var launcher = target.closest(
          '[id*="tidio"], [class*="tidio"], [data-tidio], [aria-label*="chat" i], [aria-label*="tidio" i]'
        );
        if (!launcher) return;

        trackTidioWidgetOpen({
          dedupe_key: "tidio_widget_open:launcher:" + window.location.pathname,
          source: "launcher_click"
        });
      } catch (e) {
        warn("Tidio launcher tracking failed", e);
      }
    }, true);
  }

  function ensureVariant(sessionId) {
    var existing = getStoredVariant();
    var visitorId = getVisitorId();
    if (existing) {
      assignmentReady = true;
      maybeLoadTidioForVariant(existing);
      return Promise.resolve(existing);
    }

    if (assignmentPromise) return assignmentPromise;

    assignmentPromise = postJson("/api/assign-variant", {
      shop_domain: CONFIG.shopDomain,
      session_id: sessionId,
      visitor_id: visitorId,
      page_url: window.location.href,
      referrer: document.referrer || null,
      experiment_name: CONFIG.experimentName
    })
      .then(function (response) {
        if (!response.ok) throw new Error("assign_failed");
        return response.json();
      })
      .then(function (json) {
        var variant = json && json.data && json.data.variant;

        if (variant !== "control" && variant !== "variant") {
          throw new Error("invalid_variant");
        }

        setStoredVariant(variant);
        assignmentReady = true;
        maybeLoadTidioForVariant(variant);
        log("Backend assigned variant:", variant);
        return variant;
      })
      .catch(function (err) {
        backendFailed = true;
        var fallbackVariant = getOrCreateFallbackVariant();
        setStoredVariant(fallbackVariant);
        assignmentReady = true;
        maybeLoadTidioForVariant(fallbackVariant);
        warn("Backend assignment failed, using fallback:", fallbackVariant, err);
        errorLog("BehavioralPro backend error", err);
        return fallbackVariant;
      });

    return assignmentPromise;
  }

  function buildPayload(eventName, variant, visitorId, sessionId, extra) {
    if (!ALLOWED_EVENT_NAMES[eventName]) {
      throw new Error("unsupported_event_name:" + eventName);
    }

    var context = getBaseEventContext();
    var metadata = Object.assign({}, context, extra || {});

    return {
      event_name: eventName,
      shop_domain: CONFIG.shopDomain,
      session_id: sessionId,
      visitor_id: visitorId,
      experiment_variant: variant,
      page_url: window.location.href,
      referrer: context.referrer,
      client_timestamp: nowIso(),
      event_id: createId("evt"),
      metadata: metadata
    };
  }

  function buildDataLayerEvent(payload) {
    return {
      event: payload.event_name,
      event_name: payload.event_name,
      experiment_name: CONFIG.experimentName,
      experiment_group: payload.experiment_variant === "variant" ? "experiment" : "control",
      variant: payload.experiment_variant,
      visitor_id: payload.visitor_id,
      session_id: payload.session_id,
      shop_domain: payload.shop_domain,
      event_id: payload.event_id,
      page_location: payload.page_url,
      page_path: window.location.pathname,
      page_type: CONFIG.pageType,
      timestamp: payload.client_timestamp,
      extra: payload.metadata
    };
  }

  function pushDataLayer(payload) {
    if (!CONFIG.legacyMirrorsEnabled) return;
    try {
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push(buildDataLayerEvent(payload));
    } catch (e) {
      warn("dataLayer push failed", e);
    }
  }

  function trackGA4Event(payload) {
    if (!CONFIG.legacyMirrorsEnabled) return;
    try {
      if (typeof window.gtag !== "function") return;

      window.gtag("event", payload.event_name, {
        experiment_name: CONFIG.experimentName,
        experiment_group: payload.experiment_variant === "variant" ? "experiment" : "control",
        variant: payload.experiment_variant,
        visitor_id: payload.visitor_id,
        session_id: payload.session_id,
        shop_domain: payload.shop_domain,
        event_id: payload.event_id,
        page_location: payload.page_url,
        page_path: window.location.pathname,
        page_type: CONFIG.pageType,
        timestamp: payload.client_timestamp
      });
    } catch (e) {
      warn("GA4 event failed", e);
    }
  }

  function maybeTriggerBehavioralUi(eventType, reason, messageId) {
    if (!CONFIG.active) return;
    if (
      Array.isArray(CONFIG.allowedInterventionTypes) &&
      CONFIG.allowedInterventionTypes.length > 0 &&
      CONFIG.allowedInterventionTypes.indexOf(eventType) === -1 &&
      eventType !== "review_mode" &&
      eventType !== "fallback"
    ) {
      log("Intervention blocked by storefront config:", eventType);
      return;
    }

    var interaction = getInteractionConfig(eventType, reason || "tidio_behavioral_intercept");
    var dedup = CONFIG.uiPrefix + ":" + interaction.eventType;
    if (shouldSuppressOncePerSession(dedup)) return;
    rememberEventSignature(dedup);

    var usedTidio = false;

    try {
      if (window.tidioChatApi) {
        if (messageId && typeof window.tidioChatApi.display === "function") {
          window.tidioChatApi.display(messageId);
          usedTidio = true;
        }
        if (typeof window.tidioChatApi.show === "function") {
          window.tidioChatApi.show();
          usedTidio = true;
        }
        if (typeof window.tidioChatApi.messageFromOperator === "function") {
          window.tidioChatApi.messageFromOperator(interaction.message);
          usedTidio = true;
        }
      }

      if (!usedTidio) {
        tidioFailed = true;
        log("tidioChatApi not ready for", interaction.eventType);
        return;
      }

      interactionDisplayed = true;
      info("BehavioralPro interaction displayed");
      trackEvent("intervention_triggered", {
        dedupe_key: dedup,
        intervention_type: interaction.eventType,
        message_name: messageId || ("tidio_" + interaction.eventType),
        reason: interaction.reason,
        message_copy: interaction.message,
        delivery: "tidio"
      });
      trackEvent("intervention_type", {
        dedupe_key: dedup + ":type",
        intervention_type: interaction.eventType,
        message_name: messageId || ("tidio_" + interaction.eventType),
        delivery: "tidio"
      });
      log("Triggered UI for", interaction.eventType, "via Tidio", messageId || "no_message_id");
    } catch (e) {
      tidioFailed = true;
      warn("Failed to trigger UI", e);
      errorLog("BehavioralPro Tidio error", e);
    }
  }

  async function shouldIntervene(sessionId, eventType, metadata) {
    var variant = getStoredVariant();
    if ((variant !== "variant" && !CONFIG.reviewMode) || interactionDisplayed || decisionRequestInFlight) {
      return { decision: false };
    }

    decisionRequestInFlight = true;
    var timeoutId = null;

    try {
      var controller = typeof window.AbortController === "function" ? new window.AbortController() : null;
      var timeoutPromise = new Promise(function (_, reject) {
        timeoutId = window.setTimeout(function () {
          if (controller) {
            controller.abort();
          }
          reject(new Error("intervention_decision_timeout"));
        }, 400);
      });

      var response = await Promise.race([
        postJson("/api/intervention-decision", {
        shop_domain: CONFIG.shopDomain,
        session_id: sessionId,
        event_name: eventType,
        metadata: metadata || {}
      }, {
        signal: controller ? controller.signal : undefined
        }),
        timeoutPromise
      ]);

      if (!response.ok) {
        throw new Error("intervention_decision_failed_status:" + response.status);
      }

      var json = await response.json();
      lastDecisionStrategy = json && json.strategy ? json.strategy : null;

      if (json && json.shadow_mode) {
        log("Shadow intervention:", eventType || "unknown_event", lastDecisionStrategy || "no_strategy", json.message_id || "no_message_id");
        return { decision: false };
      }

      if (!json || !json.decision) {
        log("Decision held:", eventType || "unknown_event", lastDecisionStrategy || "no_strategy", json && json.message_id ? json.message_id : "no_message_id");
        return { decision: false };
      }

      var interventionType = json.intervention_type || eventType || "page_view";
      log("Decision approved:", interventionType, lastDecisionStrategy || "no_strategy", json.message_id || "no_message_id");
      maybeTriggerBehavioralUi(interventionType, json.strategy || "backend_decision", json.message_id || null);
      return json;
    } catch (err) {
      return { decision: false };
    } finally {
      if (timeoutId) {
        window.clearTimeout(timeoutId);
      }
      decisionRequestInFlight = false;
    }
  }

  function scheduleDecisionCheck(triggerEventName, metadata) {
    if (interactionDisplayed || decisionRequestInFlight) return;
    if (!shouldTriggerInteractionForEvent(triggerEventName)) return;

    if (pendingDecisionCheck) {
      window.clearTimeout(pendingDecisionCheck);
      pendingDecisionCheck = null;
    }

    pendingDecisionCheck = window.setTimeout(function () {
      pendingDecisionCheck = null;

      if (interactionDisplayed || decisionRequestInFlight) return;

      var variant = getStoredVariant();
      if (variant !== "variant" && !CONFIG.reviewMode) return;

      shouldIntervene(getSessionId(), triggerEventName, metadata || {});
    }, 350);
  }

  function trackEvent(eventName, extra) {
    var sessionId = getSessionId();
    var visitorId = getVisitorId();

    if (!assignmentReady) {
      log("Skipped event before assignment was ready:", eventName);
      return;
    }

    var variant = getStoredVariant();
    if (variant !== "control" && variant !== "variant") {
      warn("No stored variant when trying to send event:", eventName);
      return;
    }

    var payload = buildPayload(eventName, variant, visitorId, sessionId, extra);

    pushDataLayer(payload);
    trackGA4Event(payload);

    postJson("/api/events", {
      anonymous_id: payload.visitor_id,
      session_id: payload.session_id,
      event_name: payload.event_name,
      timestamp: Math.floor(new Date(payload.client_timestamp).getTime() / 1000),
      properties: Object.assign({}, payload.metadata || {}, {
        client_event_id: payload.event_id,
        path: window.location.pathname,
        shop_domain: payload.shop_domain,
        referrer: payload.referrer,
        experiment_variant: payload.experiment_variant
      })
    })
    .then(function (response) {
      if (!response.ok) {
        throw new Error("events_failed_status:" + response.status);
      }
      log("Sent event:", eventName, variant);
    })
    .catch(function (err) {
      warn("Event send failed:", eventName, err);
      errorLog("BehavioralPro backend error", err);
    });

    if (
      eventName !== "intervention_triggered" &&
      eventName !== "intervention_type" &&
      (variant === "variant" || CONFIG.reviewMode) &&
      !(CONFIG.reviewMode && shouldDelayInteractionForReviewMode(eventName))
    ) {
      scheduleDecisionCheck(eventName, extra);
    }
  }

  function isProductPage() {
    return CONFIG.pageType === "product" || window.location.pathname.indexOf("/products/") === 0;
  }

  function isAddToCartTarget(target) {
    if (!target || !target.closest) return false;

    var form = target.closest('form[action*="/cart/add"]');
    if (form) return true;

    var el = target.closest('button, input[type="submit"], input[type="button"], a');
    if (!el) return false;

    var text = String(
      (el.textContent || "") + " " +
      (el.value || "") + " " +
      (el.getAttribute("name") || "") + " " +
      (el.getAttribute("aria-label") || "") + " " +
      (el.id || "") + " " +
      (typeof el.className === "string" ? el.className : "")
    ).toLowerCase();

    return (
      text.indexOf("add to cart") !== -1 ||
      text.indexOf("add-to-cart") !== -1 ||
      text.indexOf("add to bag") !== -1 ||
      text.indexOf("buy now") !== -1
    );
  }

  function isBeginCheckoutTarget(target) {
    if (!target || !target.closest) return false;

    var form = target.closest('form[action*="/checkout"]');
    if (form) return true;

    var link = target.closest('a[href*="/checkout"], button[name="checkout"], input[name="checkout"]');
    if (link) return true;

    var el = target.closest('button, input[type="submit"], input[type="button"], a');
    if (!el) return false;

    var text = String(
      (el.textContent || "") + " " +
      (el.value || "") + " " +
      (el.getAttribute("name") || "") + " " +
      (el.getAttribute("aria-label") || "") + " " +
      (el.id || "") + " " +
      (typeof el.className === "string" ? el.className : "")
    ).toLowerCase();

    return (
      text.indexOf("checkout") !== -1 ||
      text.indexOf("check out") !== -1 ||
      text.indexOf("secure checkout") !== -1
    );
  }

  function isCartOpenTarget(target) {
    var el = target && target.closest ? target.closest('button, a, summary, [role="button"]') : null;
    if (!el) return false;

    var text = String(
      (el.textContent || "") + " " +
      (el.getAttribute("aria-label") || "") + " " +
      (el.getAttribute("data-cart-action") || "") + " " +
      (el.id || "") + " " +
      (typeof el.className === "string" ? el.className : "")
    ).toLowerCase();

    return text.indexOf("cart") !== -1 && (
      text.indexOf("open") !== -1 ||
      text.indexOf("bag") !== -1 ||
      text.indexOf("drawer") !== -1 ||
      text.indexOf("mini-cart") !== -1
    );
  }

  function isCartCloseTarget(target) {
    var el = target && target.closest ? target.closest('button, a, [role="button"]') : null;
    if (!el) return false;

    var text = String(
      (el.textContent || "") + " " +
      (el.getAttribute("aria-label") || "") + " " +
      (el.getAttribute("data-cart-action") || "") + " " +
      (el.id || "") + " " +
      (typeof el.className === "string" ? el.className : "")
    ).toLowerCase();

    return text.indexOf("cart") !== -1 && (
      text.indexOf("close") !== -1 ||
      text.indexOf("hide") !== -1 ||
      text.indexOf("dismiss") !== -1
    );
