  function isPolicyPage() {
    var path = window.location.pathname.toLowerCase();
    return (
      path.indexOf("/policies/") === 0 ||
      path.indexOf("privacy") !== -1 ||
      path.indexOf("refund") !== -1 ||
      path.indexOf("shipping") !== -1 ||
      path.indexOf("terms") !== -1
    );
  }

  function isCouponField(target) {
    if (!target || !target.matches) return false;
    if (!target.matches('input, textarea')) return false;

    var text = String(
      (target.name || "") + " " +
      (target.id || "") + " " +
      (target.placeholder || "") + " " +
      (target.getAttribute("aria-label") || "")
    ).toLowerCase();

    return text.indexOf("discount") !== -1 || text.indexOf("coupon") !== -1 || text.indexOf("promo") !== -1;
  }

  function isDiscountApplyTarget(target) {
    var el = target && target.closest ? target.closest('button, input[type="submit"], a') : null;
    if (!el) return false;

    var text = String(
      (el.textContent || "") + " " +
      (el.value || "") + " " +
      (el.name || "") + " " +
