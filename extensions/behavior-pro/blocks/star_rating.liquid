    ).toLowerCase();

    return (
      (text.indexOf("apply") !== -1 || text.indexOf("submit") !== -1) &&
      (text.indexOf("discount") !== -1 || text.indexOf("coupon") !== -1 || text.indexOf("promo") !== -1)
    );
