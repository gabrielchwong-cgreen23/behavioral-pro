<script>
  (() => {
    const SESSION_KEY = 'behavioral_pro_session_id';
    const TRAJECTORY_KEY = 'behavioral_pro_trajectory';
    const COOKIE_SESSION = 'bp_sid';
    const COOKIE_TRAJECTORY = 'bp_t';
    const MAX_TRAJECTORY_LENGTH = 48;
    const EDGE_DECISION_URL = window.BEHAVIORALPRO_EDGE_URL || '/api/intervention-decision';
    const EVENTS_URL = window.BEHAVIORALPRO_EVENTS_URL || '/api/events';
    const CART_ATTRIBUTE_KEYS = {
      session: 'behavioral_pro_session_id',
      variant: 'behavioral_pro_variant_id',
      trajectory: 'behavioral_pro_trajectory'
    };

    function createId(prefix) {
      return `${prefix}_${Date.now()}_${Math.random().toString(36).slice(2, 10)}`;
    }

    function safeReadSessionStorage(key) {
      try {
        return window.sessionStorage.getItem(key);
      } catch {
        return null;
      }
    }

    function safeWriteSessionStorage(key, value) {
      try {
        window.sessionStorage.setItem(key, value);
      } catch {
        // Ignore storage failures.
      }
    }

    function setCookie(name, value) {
      document.cookie = `${name}=${encodeURIComponent(value)}; path=/; Secure; SameSite=Lax`;
    }

    function ensureSessionId() {
      const existing = safeReadSessionStorage(SESSION_KEY);
      if (existing) {
        setCookie(COOKIE_SESSION, existing);
        return existing;
      }

      const next = createId('bp_session');
      safeWriteSessionStorage(SESSION_KEY, next);
      setCookie(COOKIE_SESSION, next);
      return next;
    }

    function normalizeTrajectory(value) {
      const raw = String(value || '').toUpperCase().replace(/[^A-Z]/g, '');
      return raw.slice(-MAX_TRAJECTORY_LENGTH) || 'B';
    }

    function writeTrajectory(next) {
      const normalized = normalizeTrajectory(next);
      safeWriteSessionStorage(TRAJECTORY_KEY, normalized);
      setCookie(COOKIE_TRAJECTORY, normalized);
      return normalized;
    }

    function appendState(code) {
      const current = normalizeTrajectory(safeReadSessionStorage(TRAJECTORY_KEY) || 'B');
      const normalizedCode = String(code || '').trim().toUpperCase().slice(0, 1);
      if (!normalizedCode) return current;
      if (current.endsWith(normalizedCode)) {
        writeTrajectory(current);
        return current;
      }
      return writeTrajectory(`${current}${normalizedCode}`);
    }

    async function persistCartAttributes({ sessionId, variantId, trajectory }) {
      if (!variantId) return;
      try {
        await fetch('/cart/update.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Accept: 'application/json'
          },
          credentials: 'same-origin',
          body: JSON.stringify({
            attributes: {
              [CART_ATTRIBUTE_KEYS.session]: sessionId,
              [CART_ATTRIBUTE_KEYS.variant]: variantId,
              [CART_ATTRIBUTE_KEYS.trajectory]: trajectory
            }
          })
        });
      } catch {
        // Never break the storefront if cart persistence fails.
      }
    }

    function flushTrajectorySession(converted) {
      const sessionId = ensureSessionId();
      const trajectory = normalizeTrajectory(safeReadSessionStorage(TRAJECTORY_KEY) || 'B');
      const payload = JSON.stringify({
        anonymous_id: sessionId,
        session_id: sessionId,
        event_name: 'session_ended',
        timestamp: Math.floor(Date.now() / 1000),
        properties: {
          shop_domain: window.Shopify && window.Shopify.shop
            ? window.Shopify.shop
            : window.location.hostname,
          path: window.location.pathname,
          trajectory_key: trajectory,
          converted: converted ? 1 : 0,
          source: 'mdp_storefront_snippet'
        }
      });

      try {
        if (navigator.sendBeacon) {
          navigator.sendBeacon(EVENTS_URL, new Blob([payload], { type: 'application/json' }));
          return;
        }
      } catch {
        // Fall through to keepalive fetch.
      }

      void fetch(EVENTS_URL, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        credentials: 'omit',
        keepalive: true,
        body: payload
      }).catch(() => {});
    }

    function injectVariant(decision) {
      if (!decision || !decision.decision || !decision.payload) return;
      const slots = document.querySelectorAll('[data-behavioral-pro-slot]');
      slots.forEach((slot) => {
        if (decision.payload.message) {
          slot.textContent = String(decision.payload.message);
        }
        if (decision.payload.html) {
          slot.textContent = String(decision.payload.html);
        }
      });
    }

    async function fetchDecision(trigger) {
      const sessionId = ensureSessionId();
      const trajectory = appendState(trigger);
      const shopDomain = window.Shopify && window.Shopify.shop
        ? window.Shopify.shop
        : window.location.hostname;

      const url = new URL(EDGE_DECISION_URL, window.location.origin);
      url.searchParams.set('shop_domain', shopDomain);
      url.searchParams.set('session_id', sessionId);
      url.searchParams.set('trajectory', trajectory);

      try {
        const response = await fetch(url.toString(), {
          method: 'GET',
          headers: {
            Accept: 'application/json'
          },
          credentials: 'omit'
        });
        if (!response.ok) return;
        const decision = await response.json();
        injectVariant(decision);
        await persistCartAttributes({
          sessionId,
          variantId: decision.variant_id,
          trajectory
        });
      } catch {
        // Fail closed in the browser.
      }
    }

    ensureSessionId();
    writeTrajectory(safeReadSessionStorage(TRAJECTORY_KEY) || 'B');

    document.addEventListener('mousemove', (() => {
      let hoverTimer = 0;
      return (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const policyRoot = target.closest('[href*="policy"], [data-policy-link]');
        if (!policyRoot) return;
        window.clearTimeout(hoverTimer);
        hoverTimer = window.setTimeout(() => void fetchDecision('H'), 400);
      };
    })());

    document.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      if (target.closest('button, [role="button"], a[href*="/cart"], [name="add"]')) {
        void fetchDecision('C');
      }
    });

    window.addEventListener('pagehide', () => {
      appendState('B');
      flushTrajectorySession(false);
    });

    window.setTimeout(() => {
      void fetchDecision('I');
    }, 12000);
  })();
</script>
